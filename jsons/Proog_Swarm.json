  "offensiveAbilities": [
    {
      "name": "Bouncing Blobs",
      "actions": 1,
      "traits": [],
      "description": "<p>The proog swarm bounces and squishes against all creatures in its space. Each creature must succeed at a DC 22 Reflex Saving Throw save or become Clumsy 1 for as long as it remains in the swarm's space.</p>",
      "collapsed": false
    },
    {
      "name": "Leave Behind",
      "actions": 2,
      "traits": [],
      "description": "<p>The proog swarm Strides twice, dropping 1d4 proogs in the original space it occupied before taking this action.</p>",
      "collapsed": false
    },
    {
      "name": "Mimic Object",
      "actions": null,
      "traits": [],
      "description": "<p>A proog can spend 1 minute altering its appearance to imitate any solid object of 1 Bulk or less, though it can't duplicate moving parts or specialized functions. A mimicking proog gains a +2 Circumstance bonus to Deception checks to conceal its true nature. Touching the proog negates this bonus.</p>",
      "collapsed": false
    },
    {
      "name": "Schlorp",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the proog swarm's space takes 3d8 Bludgeoning Damage damage (Basic DC 22 Fortitude Saving Throw save).</p>",
      "collapsed": false
    }
  ],
