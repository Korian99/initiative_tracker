  "offensiveAbilities": [
    {
      "name": "Fold Reality",
      "actions": 2,
      "traits": [
        "concentrate",
        "occult"
      ],
      "description": "<p>The warpstitcher collapses the space between themself and another location. They choose a 10-foot square within 120 feet. The warpstitcher then Strides, treating the chosen area as adjacent to them.</p>",
      "collapsed": false
    },
    {
      "name": "Threads of Quintessence",
      "actions": null,
      "traits": [],
      "description": "<p>The warpstitcher's claws are laced with strands of quintessence they force into victims' wounds. This functions as Grab, or Improved Grab on a critical hit.</p>",
      "collapsed": false
    },
    {
      "name": "Warp Suture",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The warpstitcher has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> The warpstitcher sews the creature into themself. The creature is pulled into the warpstitcher's space and moves with the warpstitcher. It becomes restrained and takes 3d12 Force Damage damage at the end of each of its turns until freed. Additionally, it takes 1d12 Force Damage damage whenever the warpstitcher uses Resist Reality (Basic DC 34 Will Saving Throw save). The Escape DC is 34 (Escape dc=34), or the sutures can be severed (AC 25, Hardness 8, HP 30, weakness to slashing 5), freeing the creature. The warpstitcher can have up to 12 Bulk of creatures sewn into their body. The body of a creature that dies while sutured is absorbed into the warpstitcher's body and destroyed 1d4 rounds later.</p>",
      "collapsed": false
    }
  ],
