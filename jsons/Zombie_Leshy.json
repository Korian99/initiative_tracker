  "offensiveAbilities": [
    {
      "name": "Glide",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The zombie leshy glides gently through the air, moving 5 feet toward the ground and up to 25 feet forward. As long as the leshy spends at least 1 action gliding each round, it remains in the air at the end of each turn. For the purpose of determining damage from falls, a leaf leshy always treats falls as if they were 20 feet shorter.</p>",
      "collapsed": false
    },
    {
      "name": "Zombie Rot",
      "actions": null,
      "traits": [
        "disease",
        "divine",
        "void"
      ],
      "description": "<p>An infected creature can't heal damage it takes form zombie rot until it has been cured of the disease</p>\n<p><strong>Saving Throw</strong> DC 18 Fortitude save</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 4</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 5</strong> dead, rising as a plague zombie immediately, or a zombie leshy if the creature had the leshy trait.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Plague zombies are infested with horrible contagions.</p>\n<hr />\n<p>A zombie's only desire is to consume the living. Unthinking and ever-shambling harbingers of death, zombies stop only when they're destroyed.</p>",
