    {
      "name": "Throw Cargo",
      "actions": 2,
      "traits": [],
      "description": "<p>A toady carries a heavy load of supplies at their boss's behest. They hurl a heavy item they're carrying, which explodes on impact to deal <span class=\"roll\" onclick=\"roll(this)\">1d10</span> bludgeoning damage to all creatures in a 5 foot burst with a DC 14 basic Reflex save.</p>",
      "collapsed": false
