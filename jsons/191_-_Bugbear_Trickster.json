  "offensiveAbilities": [
    {
      "name": "Kick Sand",
      "actions": 1,
      "traits": [],
      "description": "<p>The creature kicks sand into an adjacent creature's face. That creature makes a DC 19 basic Reflex save. On a failure, that creature is Dazzled and treated as Off-Guard to this creature's next attack; a success negates the off-guard effects.</p>\n<p><em>Note: A DC was not provided for this ability by Paizo. The DC present here is a moderate DC for the creature level according to the Gamemastery Guide creature building Tables.</em></p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The bugbear trickster deals <span class=\"roll\" onclick=\"roll(this)\">1d8</span> extra precision damage to Off-Guard creatures.</p></details>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>These stealthy and cruel goblinoid creatures delight in spreading fear and tormenting their victims. Bugbears are the monsters lurking in the closet and hiding under the bed. Preying on remote farmsteads, bugbears reveal their presence with thumps in the night or creaks of boards to build lurking dread and arouse suspicion and fear.</p>",
  "recallKnowledge": "Society, DC: 20",
