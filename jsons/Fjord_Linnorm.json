  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "cold",
        "primal"
      ],
      "description": "<p>The fjord linnorm expels a 120 foot line of icy bile, dealing <span class=\"roll\" onclick=\"roll(this)\">17d6</span> cold damage to creatures within the area (DC 37 basic Reflex save). Any creature that fails its save is covered by the ice, which freezes and fuses with the creature's skin, giving it a -10-foot penalty to Speed. A creature can Escape or Force Open the ice (DC 34) to free itself; otherwise, the ice remains for 1 minute.</p>\n<p>The fjord linnorm can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Fjord Linnorm Venom",
      "actions": null,
      "traits": [
        "cold",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 37 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 10 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">4d6</span> cold damage and Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">6d6</span> cold damage and Clumsy 2 (1 round)</p>",
      "collapsed": false
    }
  ],
