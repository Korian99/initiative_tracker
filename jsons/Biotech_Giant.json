  "defensiveAbilities": [
    {
      "name": "Electrified Mycelium",
      "actions": null,
      "traits": [
        "aura"
      ],
      "description": "<p>10 feet. At the beginning of their turn, while the biotech giant is in contact with the ground, they can extend fungal tendrils from their body, starting as a 10-foot aura and increasing or decreasing by an additional 5 feet per turn as the giant wishes at the start of their turn. Any creature entering or starting its turn in the aura takes 5d8 Electricity Damage damage (Basic DC 28 Fortitude Saving Throw save). When the giant Steps or Strides, they end their current aura and leave behind fungal ground cover in those spaces, starting a new aura at the beginning of their next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Fungal Ground Cover",
      "actions": null,
      "traits": [],
      "description": "<p>Any creature that starts its turn in an area of fungal ground cover must succeed at a DC 26 Reflex Saving Throw save or take 3d8 Electricity Damage damage. This area is also difficult terrain for creatures other than biotech giants and fungus. Any amount of fire damage automatically destroys a square of fungal ground cover.</p>",
      "collapsed": false
    }
  ],
