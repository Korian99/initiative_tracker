  "items": [
    {
      "name": "Acid Flask (Lesser)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Strike</p>\n<p>This flask filled with corrosive acid deals 1 acid damage, <span class=\"roll\" onclick=\"roll(this)\">1d6</span> persistent acid damage, and 1 acid splash damage.</p>",
      "level": 1,
      "price": "3 gp ",
      "traits": [
        "acid",
        "alchemical",
        "bomb",
        "consumable",
        "splash"
      ]
    },
    {
      "name": "Alchemist's Fire (Lesser)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Strike</p>\n<p>Alchemist's fire is a combination of volatile liquids that ignite when exposed to air. Alchemist's fire deals <span class=\"roll\" onclick=\"roll(this)\">1d8</span> fire damage, 1 persistent fire damage, and 1 fire splash damage.</p>",
      "level": 1,
      "price": "3 gp ",
      "traits": [
        "alchemical",
        "bomb",
        "consumable",
        "fire",
        "splash"
      ]
    },
    {
      "name": "Bottled Lightning (Lesser)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Strike</p>\n<p>Bottled lightning is packed with volatile reagents that create a blast of electricity when they are exposed to air. Bottled lightning deals <span class=\"roll\" onclick=\"roll(this)\">1d6</span> electricity damage and 1 electricity splash damage. On a hit, the target becomes Off-Guard until the start of your next turn.</p>",
      "level": 1,
      "price": "3 gp ",
      "traits": [
        "alchemical",
        "bomb",
        "consumable",
        "electricity",
        "splash"
      ]
    },
    {
      "name": "Orc Knuckle Dagger",
      "quantity": 1,
      "description": "<p>This stout, metal blade of orc design has a horizontal basket hilt with blades jutting from each end, or sometimes one blade like that of a katar.</p>",
      "level": 0,
      "price": "7 sp ",
      "traits": [
        "uncommon",
        "agile",
        "disarm",
        "orc"
      ]
    },
    {
      "name": "Elixir of Life (Minor)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Interact</p>\n<p>Elixirs of life accelerate a living creature's natural healing processes and immune system. Upon drinking this elixir, you regain <span class=\"roll\" onclick=\"roll(this)\">1d6</span> healing Hit Points and gain +1 item bonus to saving throws against diseases and poisons for 10 minutes.</p>\n",
      "level": 1,
      "price": "3 gp ",
      "traits": [
        "alchemical",
        "consumable",
        "elixir",
        "healing"
      ]
    }
  ],
