  "offensiveAbilities": [
    {
      "name": "Siphon Vitality",
      "actions": 2,
      "traits": [],
      "description": "<p>The blood ooze draws forth blood from nearby creatures, causing their flesh to break open and blood to spill out, which replenishes the blood ooze. Each living creature within 15 feet takes <span class=\"roll\" onclick=\"roll(this)\">4d6</span> slashing damage (DC 24 basic Fortitude save). The blood ooze regains an amount of Hit Points equal to half the damage Siphon Vitality dealt to the single creature that took the most damage.</p>",
      "collapsed": false
