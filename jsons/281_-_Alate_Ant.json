  "offensiveAbilities": [
    {
      "name": "Frenzy",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> Once per day</p>\n<hr />\n<p><strong>Effect</strong> The alate ant enters a state of jittery agitation. It becomes Quickened for 3 rounds and can use the extra action only to Fly or Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The alate ant deals an additional <span class=\"roll\" onclick=\"roll(this)\">3d6</span> precision damage to any creature within reach of at least two of the ant's allies.</p>",
      "collapsed": false
    },
    {
      "name": "Pheromone Spray",
      "actions": 2,
      "traits": [
        "emotion",
        "mental"
      ],
      "description": "<p>The alate ant sprays a cloud of pheromones in a 15 foot cone. Non-ant creatures in the cone must succeed at a DC 37 Will save or become Confused for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds (1 minute on a critical failure). It can't use Pheromone Spray again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Red Ant Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p>While a creature is enfeebled from this poison, it is Confused (this confusion is an emotion, enchantment, and mental effect).</p>\n<p><strong>Saving Throw</strong> DC 37 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 4 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">3d6</span> poison damage and Enfeebled 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">4d6</span> poison damage and Enfeebled 2 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">6d6</span> poison damage and Enfeebled 3 (1 round)</p>",
      "collapsed": false
    }
  ],
