  "defensiveAbilities": [
    {
      "name": "Cute But Deadly",
      "actions": null,
      "traits": [
        "aura",
        "visual"
      ],
      "description": "<p>30 feet. The sight of these bunnies with their red glowing eyes and sharp teeth is so unsettling that upon seeing them a creature must attempt a DC 22 Will save. On a failure, that creature becomes Frightened 1 (or Frightened 2 on a critical failure) and cannot lower their frightened condition lower than 1 while within the aura. A creature that succeeds at its save is temporarily immune to all abyssal bunny swarm's cute but deadly auras for 1 minute.</p>",
      "collapsed": false
    }
  ],
  "speed": "40 ft,\n",
  "strikes": [],
  "offensiveAbilities": [
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">5d4</span> piercing damage (DC 21 basic Reflex save). A creature that fails its save against swarming becomes Clumsy 1 for 1 round. On a critical failure, the creature also takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> persistent plus bleed damage.</p>",
      "collapsed": false
    }
  ],
