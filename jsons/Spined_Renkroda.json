  "offensiveAbilities": [
    {
      "name": "Bristle",
      "actions": 1,
      "traits": [],
      "description": "<p>The spined renkroda bristles its spines and adopts a defensive posture, gaining a +2 circumstance bonus to AC until it uses a move action, uses Spine Deflection, or makes any Strike other than a spine Strike. Any creature that attempts a melee attack against the spined renkroda takes 3d6 Piercing Damage damage, regardless of whether the attack hits.</p>",
      "collapsed": false
    },
    {
      "name": "Spine Barrage",
      "actions": 2,
      "traits": [],
      "description": "<p>The spined renkroda makes three ranged spine Strikes.</p>",
      "collapsed": false
    },
    {
      "name": "Terrifying Roar",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The spined renkroda bellows ferociously. Each non-renkroda creature within 60 feet must attempt a DC 32 Will Saving Throw save. The creature is then temporarily immune for 10 minutes.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 3.</p>",
      "collapsed": false
    }
