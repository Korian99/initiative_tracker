  "offensiveAbilities": [
    {
      "name": "Death Roll",
      "actions": 1,
      "traits": [
        "attack"
      ],
      "description": "<p><strong>Requirements</strong> Old Thrasher must have a creature Grabbed</p>\n<hr />\n<p><strong>Effect</strong> Old Thrasher tucks its legs and rolls rapidly, twisting its victim. It makes a jaws Strike with a +2 circumstance bonus to the attack roll against the grabbed creature. If it hits, it also knocks the creature Prone. If it fails, it releases the creature.</p>",
      "collapsed": false
    },
    {
      "name": "Deep Breath",
      "actions": null,
      "traits": [],
      "description": "<p>Old Thrasher can hold its breath for about 4 hours.</p>",
      "collapsed": false
    },
    {
      "name": "Into the Deep",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> Old Thrasher must have a creature grabbed</p>\n<hr />\n<p><strong>Effect</strong> Old Thrasher Swims, bringing its victim along with it.</p>",
      "collapsed": false
    },
    {
      "name": "Thunderous Tail",
      "actions": 2,
      "traits": [],
      "description": "<p>Old Thrasher makes up to three tail Strikes against different targets. Any target hit must succeed at a Fortitude (success) (Fortitude (critical success) ) save or be knocked Prone.</p>",
      "collapsed": false
    }
