  "offensiveAbilities": [
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The drake makes two jaws Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Smokestack",
      "actions": 1,
      "traits": [
        "poison",
        "primal"
      ],
      "description": "<p>The blight drake blasts a thick, fetid smog from slits around their neck, creating a cloud of smoke in a 20ft Type:burst within 120 feet and that remains for 1d4 rounds. All creatures within the cloud become Concealed, and all creatures outside the cloud become concealed to creatures in it.</p>\n<p>Each creature that begins its turn inside the cloud takes 5d6 Poison Damage damage (Basic DC 28 Fortitude Saving Throw save). A creature that fails the save is also Sickened 1 (Sickened 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Toxic Breath",
      "actions": 2,
      "traits": [
        "acid",
        "poison",
        "primal"
      ],
      "description": "<p>The blight drake spews a fetid ball of polluted putrescence up to a range of 60 feet that explodes in a 15ft Type:burst. Creatures within the burst take 4d8 Acid Damage damage and 4d8 Poison Damage damage (Basic DC 28 Reflex Saving Throw save). The blight drake can't use Toxic Breath again for 1d4 rounds.</p>",
      "collapsed": false
    }
