      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 13 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 4 rounds</p>\n<p><strong>Stage 1</strong> 1 poison and Enfeebled 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d4</span> poison and Enfeebled 1 (1 round).</p>",
