  "offensiveAbilities": [
    {
      "name": "Eye Throwing",
      "actions": null,
      "traits": [],
      "description": "<p>A fire-eye zombie can launch its eye at foes. While its eye is out of its head, the fire-eye zombie is Blinded.</p>\n<p>At the end of its turn, a fire-eye zombie's eye flies back into its eye socket.</p>",
      "collapsed": false
    },
    {
      "name": "Wide Swing",
      "actions": 1,
      "traits": [],
      "description": "<p>The fire-eye cyclops zombie makes a spiked club Strike and compares the attack roll result to the AC of up to two foes, each of whom must be within the Strike's reach. This attack counts as two attacks for the fire-eye zombie's multiple attack penalty.</p>",
      "collapsed": false
    }
  ],
