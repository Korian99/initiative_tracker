    {
      "name": "Searing Aura",
      "actions": null,
      "traits": [
        "aura",
        "fire"
      ],
      "description": "<p>10 feet. The fire-eye zombie emits an aura of heat that causes open wounds to sizzle.</p>\n<p>Any living creature that starts its turn within 10 feet of the zombie and isn't at full HP must succeed at a DC 19 Fortitude save or take <span class=\"roll\" onclick=\"roll(this)\">1d6</span> fire damage as its wounds burn.</p>\n<p>Creatures critically hit by the fire-eye zombie's Strikes must attempt this saving throw immediately.</p>",
      "collapsed": false
    }
  ],
