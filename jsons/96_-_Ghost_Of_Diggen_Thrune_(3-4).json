  "offensiveAbilities": [
    {
      "name": "Frightful Moan",
      "actions": 1,
      "traits": [
        "auditory",
        "divine",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>Diggen Thrune laments his fate, forcing each living creature within 30 feet to attempt a DC 21 Will save. On a failure, a creature becomes Frightened 2 (or Frightened 3 on a critical failure). On a success, a creature is temporarily immune to this ghost's frightful moan for 1 minute.</p>",
      "collapsed": false
