      "name": "Object Habitation",
      "actions": null,
      "traits": [],
      "description": "<p>Diggen Thrune can occupy a magical object.</p>\n<p>Diggen can't be targeted or harmed while occupying an object, but he can only exit the object with the assistance of a mortal in possession of the object.</p>",
      "collapsed": false
    },
    {
      "name": "Rejuvenation",
      "actions": null,
      "traits": [
        "divine"
      ],
      "description": "<p>Setting Diggen free from his contractual obligations with Nashaxian allows him to move on to the afterlife.</p>",
      "collapsed": false
    }
  ],
