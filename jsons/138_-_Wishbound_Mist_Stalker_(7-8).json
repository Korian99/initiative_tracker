  "defensiveAbilities": [
    {
      "name": "Mist Cloud",
      "actions": null,
      "traits": [
        "aura",
        "primal",
        "water"
      ],
      "description": "<p>15 feet. The mist stalker is surrounded by mist. Creatures in the aura are Concealed. If wind disperses the aura, it returns automatically at the start of the mist stalker's turn. This cloud is suppressed in water.</p>",
      "collapsed": false
    },
    {
      "name": "Mist Vision",
      "actions": null,
      "traits": [],
      "description": "<p>The mist stalker ignores the Concealed condition from mist and fog.</p>",
      "collapsed": false
    }
  ],
  "speed": "20 ft,\nclimb 20 ft,\nswim 30 ft,\n",
