  "offensiveAbilities": [
    {
      "name": "Cephalaspis Charge",
      "actions": 2,
      "traits": [],
      "description": "<p>The cephalaspis corpse Strides twice, then makes an armored crest Strike. A Medium or smaller creature struck by this attack must succeed at a DC 15 Reflex Saving Throw save or be automatically Shoved back 5 feet and knocked Prone by the force of the blow.</p>",
      "collapsed": false
    },
    {
      "name": "Pummeling Loop",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p><strong>Requirements</strong> The cephalaspis corpse has a Medium or smaller creature Grabbed</p><hr /><p><strong>Effect</strong> The cephalaspis corpse attempts an Athletics check to Reposition the grabbed creature, with the following results.</p><hr /><p><strong>Critical Success</strong> The cephalaspis corpse Flies 30 feet straight up and then drops the creature, causing it to fall.</p>\n<p><strong>Success</strong> As critical success, but only 20 feet.</p>\n<p><strong>Failure</strong> No effect.</p>\n<p><strong>Critical Failure</strong> The creature is no longer grabbed.</p>",
      "collapsed": false
    },
    {
      "name": "Grab",
      "actions": 1,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Grab in its damage entry, or the monster has a creature Grabbed or Restrained</p><hr /><p><strong>Effect</strong> If used after a Strike, the monster attempts to Grapple the creature using the body part it attacked with. This attempt neither applies nor counts toward the creature's multiple attack penalty.</p><p>The monster can instead use Grab and choose one creature it's grabbing or restraining with an appendage that has Grab to automatically extend that condition to the end of the monster's next turn.</p></p></details></p>",
      "collapsed": false
    }
  ],
