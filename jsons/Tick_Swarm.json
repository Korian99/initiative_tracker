  "defensiveAbilities": [
    {
      "name": "Cling",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature leaves the swarm's space</p>\n<hr />\n<p><strong>Effect</strong> The swarm takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> damage as ticks cling to the creature and continue biting, dealing <span class=\"roll\" onclick=\"roll(this)\">3d6</span> bleed. Immersion in water reduces the DC of the flat check to end this persistent damage to 5, and any area damage dealt to the creature destroys these clinging ticks.</p>",
      "collapsed": false
    }
  ],
  "speed": "25 ft,\nclimb 25 ft,\n",
  "strikes": [],
  "offensiveAbilities": [
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">3d6</span> piercing damage (DC 28 basic Reflex save) plus Cling and exposure to tick fever.</p>",
      "collapsed": false
    },
    {
      "name": "Tick Fever",
      "actions": null,
