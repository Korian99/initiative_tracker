    {
      "name": "Vengeful Flash",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature makes a successful melee attack against the spirit or makes a successful Acrobatics check to Tumble Through the spirit's space</p>\n<hr />\n<p><strong>Effect</strong> The spirit emits a brief pulse of void energy that deals <span class=\"roll\" onclick=\"roll(this)\">5d6</span> void damage to the triggering creature (DC 26 basic Reflex save).</p>",
