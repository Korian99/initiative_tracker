    {
      "name": "Focused Assault",
      "actions": 2,
      "traits": [],
      "description": "<p>The giant pirate skeleton makes two Strikes with its claw against one foe. The multiple attack penalty doesn't increase until after both attacks are resolved.</p>\n<p>The giant pirate skeleton doesn't use this ability if there is more than one creature within its reach that it can see.</p>",
      "collapsed": false
    },
    {
      "name": "Impaling Hook",
      "actions": null,
      "traits": [],
      "description": "<p>A creature critically hit by the giant pirate skeleton's gaff hook is impaled upon it.</p>\n<p>The creature is Grabbed by the giant pirate skeleton and whenever the giant pirate skeleton maintains the grab, the creature takes <span class=\"roll\" onclick=\"roll(this)\">1d10+10</span> piercing damage from the agonizing wound.</p>",
      "collapsed": false
    }
