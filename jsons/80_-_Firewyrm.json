      "name": "Breath Fire",
      "actions": 2,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p>The firewyrm breathes a 30 foot cone of fire dealing <span class=\"roll\" onclick=\"roll(this)\">7d6</span> fire plus <span class=\"roll\" onclick=\"roll(this)\">2d8</span> persistent plus fire damage to every creature within the cone (DC 28 basic Reflex save).</p>\n<p>The firewyrm can't Breathe Fire again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
