    }
  ],
  "speed": "0 ft,\nswim 25 ft,\n",
  "strikes": [],
  "offensiveAbilities": [
    {
      "name": "Inject Poison",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">2d4</span> piercing damage (DC 18 basic Reflex save). Creatures that fail the save are exposed to stonefish swarm venom.</p>",
      "collapsed": false
    },
    {
      "name": "Stonefish Swarm Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 18 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison and Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison and Clumsy 2 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> poison damage and clumsy 2 (1 round)</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Stonefish occasionally band together where food is abundant, filling all nooks and crannies of a coral reef. In large numbers, stonefish can take on prey much larger than themselves.</p>",
