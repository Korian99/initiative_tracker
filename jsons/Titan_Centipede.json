  "offensiveAbilities": [
    {
      "name": "Impaling Critical",
      "actions": null,
      "traits": [],
      "description": "<p>When a titan centipede scores a critical hit with its mandibles, the target is painfully pierced with barbed spines and bristles, taking <span class=\"roll\" onclick=\"roll(this)\">1d6</span> bleed and becoming Off-Guard as long as the bleed damage continues.</p>",
      "collapsed": false
    },
    {
      "name": "Titan Centipede Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 28 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> poison damage and Clumsy 2 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d8</span> poison damage, Clumsy 2, and Slowed 1 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">2d10</span> poison damage, Clumsy 2, and Slowed 2 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Trample",
      "actions": 3,
      "traits": [],
      "description": "<p>Huge or smaller, foot, DC 28 basic Reflex save</p>\n<details><summary>See rules...</summary>\n<p><p>The monster Strides up to double its Speed and can move through the spaces of creatures of the listed size, Trampling each creature whose space it enters. The monster can attempt to Trample the same creature only once in a single use of Trample. The monster deals the damage of the listed Strike, but trampled creatures can attempt a basic Reflex save at the listed DC (no damage on a critical success, half damage on a success, double damage on a critical failure).</p></p></details>",
      "collapsed": false
    },
    {
      "name": "Undulate",
      "actions": 1,
      "traits": [],
      "description": "<p>The titan centipede Strides up to its Speed or Steps. During this movement, it can pass through spaces as narrow as 10 feet without Squeezing.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>These colossal, solitary centipedes claim vast hunting grounds.</p>",
