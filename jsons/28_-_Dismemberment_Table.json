  "offensiveAbilities": [
    {
      "name": "Disabling Strike",
      "actions": 1,
      "traits": [],
      "description": "<p>The dismemberment table attempts a blade Strike on a single target that it has Grabbed or Restrained. If this Strike hits, the blade cuts deep into one of the target's limbs. The target must attempt a DC 22 Fortitude save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature suffers no additional effect.</p>\n<p><strong>Success</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> bleed damage.</p>\n<p><strong>Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">2d6</span> bleed damage and is Clumsy 1. This clumsy condition ends once the creature is restored to full Hit Points.</p>\n<p><strong>Critical Failure</strong> As failure, but Clumsy 2.</p>",
      "collapsed": false
    }
  ],
