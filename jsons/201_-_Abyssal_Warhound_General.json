  "offensiveAbilities": [
    {
      "name": "Caustic Drool",
      "actions": 1,
      "traits": [
        "acid"
      ],
      "description": "<p>Caustic saliva drips from the warhound's mouth. Until the end of its turn, the abyssal warhound's jaws Strike deals an additional 2 points of acid damage on a successful attack, or 4 points on a critical success.</p>\n<p>Effect: Caustic Drool</p>",
      "collapsed": false
    },
    {
      "name": "Caustic Vomit",
      "actions": 2,
      "traits": [
        "acid",
        "divine"
      ],
      "description": "<p>The abyssal warhound purebred spews acidic vomit that deals <span class=\"roll\" onclick=\"roll(this)\">9d6</span> acid damage in a 40 foot cone (DC 25 basic Fortitude save). It can't use Caustic Vomit again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Shake",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The abyssal warhound's Caustic Drool ability is active</p>\n<hr />\n<p><strong>Effect</strong> The warhound shakes its head, splattering nearby creatures with caustic saliva. All creatures within 10 feet of the warhound take <span class=\"roll\" onclick=\"roll(this)\">5d6</span> acid damage (DC 23 basic Reflex save) and the warhound's Caustic Drool ability ends. Abyssal warhounds are immune to this damage.</p>",
      "collapsed": false
    },
    {
      "name": "Warning Growl",
      "actions": -1,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p><strong>Trigger</strong> A creature targets the warhound with a melee Strike</p>\n<hr />\n<p><strong>Effect</strong> The warhound Demoralizes the triggering creature and does not take a penalty for not speaking a language. The results of this check occur before resolving the triggering Strike.</p>",
      "collapsed": false
    }
  ],
