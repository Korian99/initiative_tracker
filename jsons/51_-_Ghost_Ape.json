    {
      "name": "Ghost Stance",
      "actions": 1,
      "traits": [
        "concentrate",
        "illusion",
        "occult",
        "stance",
        "visual"
      ],
      "description": "<p>The ghost ape phases partially out of existence, its form blurring and becoming difficult to pinpoint. While in this stance, they are Concealed to any creature that isn't adjacent to them. They can't use this concealment to Hide or Sneak. They also gain resistance 5 to physical damage. If the ghost ape takes force damage, this stance ends and they can't reenter it for <span class=\"roll\" onclick=\"roll(this)\">1d3</span> rounds.</p>",
      "collapsed": false
    }
  ],
