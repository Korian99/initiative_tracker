      "traits": []
    },
    {
      "name": "Bolts",
      "quantity": 10,
      "description": "<p>Shorter than traditional arrows but similar in construction, bolts are the ammunition used by crossbows.</p>",
      "level": 0,
      "price": "1 sp ",
      "traits": []
    },
    {
      "name": "Elixir of Life (Lesser)",
      "quantity": 1,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Interact</p>\n<p>Elixirs of life accelerate a living creatures natural healing processes and immune system. Upon drinking this elixir, you regain <span class=\"roll\" onclick=\"roll(this)\">3d6+6</span> healing Hit Points and gain +1 item bonus to saving throws against diseases and poisons for 10 minutes.</p>\n",
      "level": 5,
      "price": "30 gp ",
      "traits": [
        "alchemical",
        "consumable",
        "elixir",
        "healing"
      ]
    }
