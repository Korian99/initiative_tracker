  "offensiveAbilities": [
    {
      "name": "Foul Concoction",
      "actions": 2,
      "traits": [
        "manipulate",
        "poison"
      ],
      "description": "<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> Aliver quickly mixes alchemical catalysts and materials together, creating a burst of foul-smelling smoke that fills a 10 foot emanation. The cloud functions as Stinking Cloud (DC 25 Fortitude save) except that Aliver is immune to the putrid stench created by the concoction.</p>",
      "collapsed": false
    },
    {
      "name": "Precise Poisoning",
      "actions": 2,
      "traits": [],
      "description": "<p>Aliver applies a dose of poison (typically a dose of Giant Wasp Venom) to a bolt on his crossbow, then takes careful aim with the poisoned bolt and attempts a ranged Strike with his hand crossbow. If he hits, he inflicts an additional <span class=\"roll\" onclick=\"roll(this)\">1d6</span> piercing damage with the bolt as well as the poison effect.</p>",
      "collapsed": false
    },
    {
      "name": "Quick Bomber",
      "actions": 1,
      "traits": [],
      "description": "<p>Aliver Interacts to draw a bomb, then Strikes with it.</p>",
      "collapsed": false
    }
  ],
