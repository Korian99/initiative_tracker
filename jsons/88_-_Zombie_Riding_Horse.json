  "offensiveAbilities": [
    {
      "name": "Feast",
      "actions": 2,
      "traits": [],
      "description": "<p>The zombie riding horse Strikes with its jaws against an adjacent living creature or a creature that has died in the past hour. On a success, the zombie riding horse can feast upon the creature's flesh to heal itself. This restores <span class=\"roll\" onclick=\"roll(this)\">1d6</span> healing Hit Points.</p>",
      "collapsed": false
    },
    {
      "name": "Gallop",
      "actions": 2,
      "traits": [],
      "description": "<p>The zombie riding horse Strides twice. It has a +10-foot circumstance bonus to its Speed during these Strides</p>",
