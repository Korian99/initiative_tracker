    {
      "name": "Breathe Fire",
      "actions": 1,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p><strong>Requirements</strong> Viktor is holding an ignited baton</p>\n<hr />\n<p><strong>Effect</strong> Viktor breathes fire in a 20 foot cone. Creatures within the cone take <span class=\"roll\" onclick=\"roll(this)\">3d6</span> fire damage (DC 18 basic Reflex save).</p>\n<p>Once Viktor breathes fire, he cannot do so again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Ignite Baton",
      "actions": 2,
      "traits": [],
      "description": "<p>Viktor ignites or douses a baton. Ignited batons burn for 10 minutes or until Viktor douses them.</p>",
      "collapsed": false
    },
    {
      "name": "Set on Fire",
      "actions": null,
      "traits": [],
      "description": "<p>If Viktor critically hits a target with an attack that deals fire damage, or if a target of one of his effects that deals fire damage critically fails its saving throw, the target takes <span class=\"roll\" onclick=\"roll(this)\">1d4</span> persistent plus fire damage.</p>",
      "collapsed": false
    }
