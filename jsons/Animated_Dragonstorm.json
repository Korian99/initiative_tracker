  ],
  "offensiveAbilities": [
    {
      "name": "Channel Dragonstorm",
      "actions": 2,
      "traits": [
        "divine"
      ],
      "description": "<p>The animated dragonstorm directs a 30 foot cone of dragonstorm energy. This deals <span class=\"roll\" onclick=\"roll(this)\">3d8</span> acid, <span class=\"roll\" onclick=\"roll(this)\">3d8</span> cold, <span class=\"roll\" onclick=\"roll(this)\">3d8</span> electricity, <span class=\"roll\" onclick=\"roll(this)\">3d8</span> fire, and <span class=\"roll\" onclick=\"roll(this)\">3d8</span> poison damage to creatures in the cone (DC 40 basic Reflex save). The animated dragonstorm can't use Channel Dragonstorm again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Destructive Strikes",
      "actions": null,
      "traits": [],
      "description": "<p>The animated dragonstorm's attacks ignore the Hardness of objects with Hardness 20 or less.</p>",
      "collapsed": false
    },
    {
      "name": "Dragonstorm Strike",
      "actions": null,
      "traits": [],
      "description": "<p>On a critical hit, the animated dragonstorm's fist bursts with dragonstorm energy. The target takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> acid, <span class=\"roll\" onclick=\"roll(this)\">1d6</span> cold, <span class=\"roll\" onclick=\"roll(this)\">1d6</span> electricity, <span class=\"roll\" onclick=\"roll(this)\">1d6</span> fire, and <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison damage.</p>",
      "collapsed": false
    }
  ],
