  "offensiveAbilities": [
    {
      "name": "Vacuum Mouth",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The giant tardigrade doesn't have a target Grabbed</p>\n<hr />\n<p><strong>Effect</strong> The giant tardigrade draws in air with its mouth. All creatures in a 20 foot cone must succeed at a DC 25 Reflex save or be pulled adjacent to the giant tardigrade. The tardigrade chooses one creature that failed its save, Grabbing the target in its claws and making a stylet Strike.</p>",
      "collapsed": false
