  "offensiveAbilities": [
    {
      "name": "Fascinating Dance",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> The dancer Strides up to their Speed. Once during this movement, when the dancer is adjacent to a creature, the dancer can attempt to mesmerize that creature, who attempts a DC 17 Will save. On a failure, that creature is Fascinated with the dancer until the end of its next turn.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Dance can be used to tell stories, share emotions, provide entertainment, and display a performer's athletic ability.</p><hr /><p>Performances come in a wide variety of forms, from musical methods like singing and instruments to physical dancing and juggling to simple orating and conversing.</p>",
