    {
      "name": "Crunch",
      "actions": 1,
      "traits": [
        "attack"
      ],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirements</strong> A creature is Grabbed in the nyssholora's jaws</p><hr /><p><strong>Effect</strong> The nyssholora chomps down on the creature, dealing (1d8+7) Piercing Damage damage.</p>",
      "collapsed": false
    },
    {
      "name": "Discordant Bellow",
      "actions": 2,
      "traits": [
        "primal",
        "sonic"
      ],
      "description": "<p>The nyssholora unleashes a blast of discordant sound that deal 5d6 Sonic Damage damage in a 30ft Type:cone (Basic DC 21 Reflex Saving Throw save). Objects and constructs in the area are treated as if they had half as much Hardness as usual. Creatures that critically fail their saving throw are also Slowed 1 for 1 round. The nyssholora can't use Discordant Bellow again for 1d4 rounds.</p>",
      "collapsed": false
    },
