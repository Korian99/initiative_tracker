  "items": [
    {
      "name": "Healer's Toolkit",
      "quantity": 1,
      "description": "<p>This kit of bandages, herbs, and suturing tools is necessary for Medicine checks to Administer First Aid, Treat Disease, Treat Poison, or Treat Wounds. If you wear your healer's toolkit, you can draw and replace its tools as part of the action that uses them.</p>",
      "level": 0,
      "price": "5 gp ",
      "traits": []
    },
    {
      "name": "Elixir of Life (Minor)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> (manipulate)</p><hr /><p>Elixirs of life accelerate a living creature's natural healing processes and immune system. Upon drinking this elixir, you regain <span class=\"roll\" onclick=\"roll(this)\">1d6</span> healing Hit Points and gain +1 item bonus to saving throws against diseases and poisons for 10 minutes.</p>\n",
      "level": 1,
      "price": "3 gp ",
      "traits": [
        "alchemical",
        "consumable",
        "elixir",
        "healing"
      ]
    }
  ],
  "generalAbilities": [
    {
      "name": "Bedside Manner",
      "actions": null,
      "traits": [],
      "description": "<p>A physician has a +4 circumstance bonus to Diplomacy checks to Make an impression on or make a Request of a diseased, poisoned, or wounded creature.</p>",
      "collapsed": false
    },
    {
      "name": "Doctor's Hand",
      "actions": null,
      "traits": [],
      "description": "<p>When the physician rolls a critical failure on a check to Treat Disease, Treat Poison, or Treat Wounds, they get a failure instead.</p>",
