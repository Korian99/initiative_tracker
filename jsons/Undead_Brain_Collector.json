  "offensiveAbilities": [
    {
      "name": "Brainlash",
      "actions": 2,
      "traits": [
        "mental",
        "occult"
      ],
      "description": "<p>The undead brain collector extrudes a writhing tangle of ectoplasm from its bursted brain blisters. These ectoplasmic strands lash out at all living targets within 30 feet. Targets in this area must attempt a DC 25 Will save.</p>\n<p>After the undead brain collector uses this ability, seven phantom brains glow and shimmer where its brain blisters once were. It can't use Brainlash again until all seven phantom brains are Absorbed.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">4d6</span> mental damage.</p>\n<p><strong>Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">8d6</span> mental damage.</p>\n<p><strong>Critical Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">8d6</span> mental damage and is Confused.</p>",
      "collapsed": false
    },
    {
      "name": "Mind-Rotting Toxin",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 25 basic Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<hr />\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void and Stupefied 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void, stupefied 1, and Slowed 1 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> void, Stupefied 2, and slowed 1 (1 round)</p>",
      "collapsed": false
    }
  ],
