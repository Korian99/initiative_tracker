    {
      "name": "Dust",
      "actions": null,
      "traits": [
        "aura"
      ],
      "description": "<p>30 feet. The pachinyam swarm shakes it thick fur and releases a cloud of dust and dander in a 30-foot radius burst centered on a corner of one of its squares that functions as a mist spell. This dust cloud blocks electronic communication to and from anyone inside the cloud. Any item with the tech trait becomes glitching 1 if it's inside the dust cloud.</p>",
      "collapsed": false
    }
  ],
  "speed": "30 ft, climb 10ft",
  "strikes": [],
  "offensiveAbilities": [
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes 2d8 Piercing Damage damage (Basic DC 20 Reflex Saving Throw save). Creatures that fail this save are Sickened 1 (Sickened 2 on a critical failure). While within a pachinyam's dust cloud and sickened, the creature is also suppressed until it leaves the cloud or recovers from the sickened condition.</p>",
      "collapsed": false
    }
