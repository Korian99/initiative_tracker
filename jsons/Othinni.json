  "offensiveAbilities": [
    {
      "name": "Greater Constrict",
      "actions": 1,
      "traits": [],
      "description": "<p>(3d6+12) Fire Damage, Basic DC 32 Fortitude Saving Throw</p><hr /><p><details><summary>See rules...</summary>\n<p><p>The monster deals the listed amount of damage to any number of creatures Grabbed or Restrained by it. Each of those creatures can attempt a basic Fortitude save with the listed DC. A creature that fails this save falls Unconscious, and a creature that succeeds is then temporarily immune to falling unconscious from Greater Constrict for 1 minute.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Infernal Binding",
      "actions": 2,
      "traits": [
        "divine",
        "incapacitation"
      ],
      "description": "<p>The othinni binds a creature within 100 feet with diabolic runes, and the target must attempt a DC 32 Will Saving Throw save. On a failure, the target is Immobilized for 1 round. On a critical failure, the creature is immobilized for 1 minute but can attempt a new saving throw at the start of each of its turns to end the effect.</p>",
      "collapsed": false
    },
    {
      "name": "Psychic Screech",
      "actions": 2,
      "traits": [
        "fear",
        "mental"
      ],
      "description": "<p>The othinni unleashes a mental wail in a 30ft Type:emanation. All creatures in this area must attempt a DC 32 Will Saving Throw save.</p><hr /><p><strong>Critical Success</strong> No effect.</p>\n<p><strong>Success</strong> The creature becomes Frightened 1.</p>\n<p><strong>Failure</strong> The creature becomes Frightened 2 and Confused for as long as it's frightened.</p>\n<p><strong>Critical Failure</strong> As failure, but Frightened 3.</p>",
      "collapsed": false
    }
  ],
