  "defensiveAbilities": [
    {
      "name": "Rejuvenation",
      "actions": null,
      "traits": [
        "divine"
      ],
      "description": "<p>Jin is put to rest if both Darivan (area <strong>C7</strong>) and the bloom of Lamashtu (area <strong>C10</strong>) are defeated.</p>\n<p>When a ghost is destroyed, it re-forms after <span class=\"roll\" onclick=\"roll(this)\">2d4</span> days within the location it's bound to, fully healed. A ghost can be permanently destroyed only if someone determines the reason for its existence and sets right whatever prevents the spirit from resting.</p>",
      "collapsed": false
    }
  ],
  "speed": "0 ft,\nfly 25 ft,\n",
  "strikes": [
    {
      "type": "melee",
      "name": "Ghostly Hand",
      "bonus": 19,
      "traits": [
        "agile",
        "finesse",
        "magical"
      ],
      "damageRolls": [
        {
          "roll": "2d8+10",
