        }
      ],
      "effects": [],
      "usedAttributeToHit": "dexterity",
      "usedAttributeDamage": "strength",
      "toHitModifications": [],
      "damageModifications": []
    }
  ],
  "offensiveAbilities": [
    {
      "name": "Frightful Moan",
      "actions": 2,
      "traits": [
        "auditory",
        "divine",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The ghost laments its fate, forcing each living creature within 30 feet to attempt a DC 28 Will save. On a failure, a creature becomes Frightened 2 (or Frightened 3 on a critical failure). On a success, a creature is temporarily immune to this ghost's frightful moan for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Telekinetic Assault",
      "actions": 2,
      "traits": [
        "divine"
      ],
      "description": "<p>The ghost cries out in pain and anguish as small objects and debris fly about in a 30 foot emanation. Creatures in this area take <span class=\"roll\" onclick=\"roll(this)\">5d6</span> bludgeoning damage, subject to a DC 28 basic Reflex save.</p>",
      "collapsed": false
    }
  ],
