      ],
      "description": "<p>10 feet. A creature that enters the area must attempt a DC 28 Will save.</p>\n<hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">2d6</span> spirit damage.</p>\n<p><strong>Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">4d6</span> spirit damage and is Frightened 1 for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">8d6</span> spirit damage and is frightened 1 as long as the portal to the Abyss remains open.</p>",
      "collapsed": false
    },
    {
      "name": "Thrash About",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> The hand takes enough damage to lose an action</p>\n<hr />\n<p><strong>Effect</strong> the hand thrashes about in pain, causing a minor earthquake. Creatures within 60 feet of the portal must succeed at a DC 28 Reflex save or be knocked Prone.</p>",
      "collapsed": false
    }
