  "weaknesses": [],
  "defensiveAbilities": [
    {
      "name": "Rejuvenation",
      "actions": null,
      "traits": [
        "occult"
      ],
      "description": "<p>Restoring the vandalized inscriptions and reciting their corrected stories ushers these spirits back to the afterlife.</p>\n<hr />\n<p>When a ghost is destroyed, it re-forms after <span class=\"roll\" onclick=\"roll(this)\">2d4</span> days within the location it's bound to, fully healed. A ghost can be permanently destroyed only if someone determines the reason for its existence and sets right whatever prevents the spirit from resting.</p>",
      "collapsed": false
    }
  ],
