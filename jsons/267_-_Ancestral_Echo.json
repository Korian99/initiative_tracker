  "generalAbilities": [
    {
      "name": "Riled by Disrespect",
      "actions": null,
      "traits": [],
      "description": "<p>An ancestral echo gains a +1 status bonus to attack rolls and saving throw DCs against any creature that has not performed at least one task to beautify the site to which the echo is bound. This applies to any PC who didn't succeed at one or more skill checks to clean area <strong>D2</strong>.</p>",
      "collapsed": false
    },
    {
      "name": "Site Bound",
      "actions": null,
      "traits": [],
      "description": "<p>The ancestral echo can't leave the upper crypt.</p>\n<hr />\n<p>A typical ghost can stray only a short distance from where it was killed or the place it haunts. A typical limit is 120 feet. Some ghosts are instead bound to a room, building, item, or creature that was special to it rather than a location.</p>",
      "collapsed": false
    }
  ],
