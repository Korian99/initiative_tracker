  "offensiveAbilities": [
    {
      "name": "Flea Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p>Drain from flea fever can't be reduced or recovered from naturally until the disease is cured.</p>\n<p><strong>Saving Throw</strong> DC 18 Fortitude save</p>\n<p><strong>Stage 1</strong> Drained 1 (<span class=\"roll\" onclick=\"roll(this)\">1d4</span> hours)</p>\n<p><strong>Stage 2</strong> drained 1 and Sickened 1 (1 day)</p>\n<p><strong>Stage 3</strong> Drained 2 and sickened 1 (1 day)</p>\n<p><strong>Stage 4</strong> Drained 3 and sickened 1 (1 day)</p>\n<p><strong>Stage 5</strong> dead</p>",
      "collapsed": false
    },
    {
      "name": "Suck Blood",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The giant flea's last action was a successful proboscis Strike</p>\n<hr />\n<p><strong>Effect</strong> The giant flea drinks the creature's blood. The victim becomes Drained 1 and the flea regains 5 healing HP.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Giant fleas are commonly found in areas containing hardy megafauna, such as dinosaurs or mammoths.</p>\n<hr />\n<p>Fleas are little more than a nuisance in most circumstances, but can be lethal when they grow to monstrous proportions or gather in enormous swarms.</p>",
