      "name": "Fling Offal",
      "bonus": 17,
      "traits": [
        "range-increment-30"
      ],
      "damageRolls": [
        {
          "roll": "2d6+11",
          "type": "bludgeoning"
        }
      ],
      "critRolls": [
        {
          "roll": "(2d6+11)*2",
          "type": "bludgeoning"
        }
      ],
      "effects": [
        "Wretched-weeps"
      ],
      "usedAttributeToHit": "dexterity",
      "usedAttributeDamage": "none",
      "toHitModifications": [],
      "damageModifications": []
    }
  ],
  "offensiveAbilities": [
    {
      "name": "Bury in Offal",
      "actions": 1,
      "traits": [],
      "description": "<p>The ofalth zombie makes a fling offal Strike and compares the attack roll result to the AC of any foes within the area of a 15 foot cone emanating from the ofalth zombie. This counts as two attacks for the ofalth zombie's multiple attack penalty.</p>\n<p>The ofalth zombie can't use Bury in Offal again until it moves at least 10 feet to a different space.</p>",
      "collapsed": false
    },
    {
      "name": "Wretched Weeps",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 22 Fortitude save</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d8</span> bleed every hour and Enfeebled 1 (1 day)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">2d8</span> bleed every hour and Enfeebled 2 (1 day)</p>",
      "collapsed": false
    }
  ],
