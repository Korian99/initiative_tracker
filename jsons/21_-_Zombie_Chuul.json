  "offensiveAbilities": [
    {
      "name": "Constrict",
      "actions": 1,
      "traits": [],
      "description": "<p> <span class=\"roll\" onclick=\"roll(this)\">1d12+7</span> bludgeoning damage, DC 25 basic Fortitude save (Grabbed by claw only)</p>\n<details><summary>See rules...</summary>\n<p><p>The monster deals the listed amount of damage to any number of creatures Grabbed or Restrained by it. Each of those creatures can attempt a basic Fortitude save with the listed DC.</p></p></details>",
      "collapsed": false
    },
    {
      "name": "Mandibles",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> A creature is Grabbed and Paralyzed by the zombie chuul's tentacles</p>\n<hr />\n<p><strong>Effect</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">3d6</span> piercing damage.</p>",
      "collapsed": false
    },
    {
      "name": "Paralytic Venom",
      "actions": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 25 Fortitude save</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> Paralyzed (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Tentacle Transfer",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The zombie chuul has a creature Grabbed</p>\n<hr />\n<p><strong>Effect</strong> The zombie chuul transfers the grabbed creature from its claws to its tentacles, or vice versa. The creature is exposed to the zombie chuul's paralytic venom when transferred into the tentacles and at the start of each of the zombie chuul's turns if it remains grabbed by the tentacles.</p>",
      "collapsed": false
    }
  ],
