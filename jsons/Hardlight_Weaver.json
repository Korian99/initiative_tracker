      "name": "Constrict",
      "actions": 1,
      "traits": [],
      "description": "<p>(2d8+6) Bludgeoning Damage, Basic DC 26 Fortitude Saving Throw</p><hr /><p><details><summary>See rules...</summary>\n<p><p>The monster deals the listed amount of damage to any number of creatures Grabbed or Restrained by it. Each of those creatures can attempt a basic Fortitude save with the listed DC.</p></p></details></p>",
      "collapsed": false
    },
    {
      "name": "Virtual Roadblocks",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p>The hardlight weaver creates a stationary medium (◆), large (◆◆), or huge (◆◆◆) hardlight obstacle, the center of which must be within its digital reality aura. These obstacles are difficult and hazardous terrain for non-hardlight life-forms, dealing 9 Force Damage damage. The Virtual Roadblocks remain until the hardlight weaver uses this ability again or until its aura moves out of range, whichever comes first.</p>",
      "collapsed": false
    }
