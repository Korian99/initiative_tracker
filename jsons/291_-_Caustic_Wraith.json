  "defensiveAbilities": [
    {
      "name": "Aggravating Aura",
      "actions": null,
      "traits": [
        "acid",
        "aura",
        "mental"
      ],
      "description": "<p>10 feet. Acidic vapor surrounds the caustic wraith, making other creatures' bodies feel raw and especially sensitive to pain. A creature that begins in the area must succeed at a DC 28 Will save or gain weakness 3 to all damage for 1 round (weakness 5 on a critical failure).</p><hr /><p>Effect: Aggravating Aura</p>",
      "collapsed": false
    }
  ],
  "speed": "0 ft,\nfly 40 ft,\n",
  "strikes": [
    {
      "type": "melee",
      "name": "Caustic Touch",
      "bonus": 21,
      "traits": [
        "acid",
        "finesse",
        "reach-10",
        "void"
      ],
      "damageRolls": [
        {
          "roll": "2d8",
          "type": "void"
        },
        {
          "roll": "1d8",
          "type": "acid"
        }
      ],
      "critRolls": [
        {
          "roll": "(2d8)*2",
          "type": "void"
        },
        {
          "roll": "(1d8)*2",
          "type": "acid"
        }
      ],
      "effects": [
        "Drain-life"
      ],
      "usedAttributeToHit": "dexterity",
      "usedAttributeDamage": "strength",
      "toHitModifications": [],
      "damageModifications": []
    }
  ],
  "offensiveAbilities": [
    {
      "name": "Dissolve From the Inside",
      "actions": 2,
      "traits": [],
      "description": "<p>The caustic wraith reaches into the body of a creature within 10 feet, melting its organs and inflicting pain. The target takes <span class=\"roll\" onclick=\"roll(this)\">4d8</span> acid damage with a DC 28 basic Fortitude save. On a critical failure, the creature is also Sickened 2.</p>",
      "collapsed": false
    },
    {
      "name": "Drain Life",
      "actions": null,
      "traits": [
        "divine"
      ],
      "description": "<p>When the caustic wraith damages a living creature with its caustic touch Strike, the wraith gains 10 temporary Hit Points, and the target must succeed at a DC 28 Fortitude save or become Drained 1. Further damage dealt by the caustic wraith increases the drained condition value by 1 on a failed save, to a maximum of Drained 4.</p>",
      "collapsed": false
    },
    {
      "name": "Wraith Spawn",
      "actions": null,
      "traits": [
        "divine",
        "unholy"
      ],
      "description": "<p>A living humanoid slain by a caustic wraith rises as a wraith spawn after <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds. This wraith spawn is under the command of the wraith that killed it. It doesn't have drain life or wraith spawn and becomes Clumsy 2. After 24 hours, the wraith spawn dissipates and is destroyed.</p>",
      "collapsed": false
    }
  ],
