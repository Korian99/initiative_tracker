            "electricity",
            "manipulate"
          ],
          "castingTime": "2",
          "duration": "",
          "range": "30 feet",
          "area": "",
          "targets": "1 or 2 creatures",
          "save": "basic reflex",
          "description": "<p>An arc of lightning leaps from one target to another. You deal electricity damage equal to <span class=\"roll\" onclick=\"roll(this)\">1d4</span> plus your spellcasting ability modifier.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by <span class=\"roll\" onclick=\"roll(this)\">1d4</span>.</p>",
