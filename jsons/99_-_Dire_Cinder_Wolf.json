  "offensiveAbilities": [
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The dire cinder wolf's Strikes deal <span class=\"roll\" onclick=\"roll(this)\">1d4</span> extra precision damage to creatures within reach of at least two of the wolf's allies.</p>",
      "collapsed": false
    },
    {
      "name": "Worry",
      "actions": 1,
      "traits": [
        "attack"
      ],
      "description": "<p><strong>Requirements</strong> The dire cinder wolf has a creature Grabbed with its jaws</p>\n<hr />\n<p><strong>Effect</strong> The dire wolf fiercely shakes the grabbed creature with its teeth, dealing <span class=\"roll\" onclick=\"roll(this)\">1d10+2</span> piercing damage plus 1 fire damage (DC 20 basic Fortitude save).</p>",
      "collapsed": false
    }
