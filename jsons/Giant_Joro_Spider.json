  "offensiveAbilities": [
    {
      "name": "Attack of Opportunity",
      "actions": -1,
      "traits": [],
      "description": "<p><p><strong>Trigger</strong> A creature within the monster's reach uses a manipulate action or a move action, makes a ranged attack, or leaves a square during a move action it's using.</p>\n<hr />\n<p><strong>Effect</strong> The monster attempts a melee Strike against the triggering creature. If the attack is a critical hit and the trigger was a manipulate action, the monster disrupts that action. This Strike doesn't count toward the monster's multiple attack penalty, and its multiple attack penalty doesn't apply to this Strike.</p></p>",
      "collapsed": true
    },
    {
      "name": "Joro Spider Venom",
      "actions": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 25 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d8</span> poison (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d8</span> poison and Slowed 1 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">1d8</span> poison and Slowed 2 (1 round)</p>\n<p><strong>Stage 4</strong> <span class=\"roll\" onclick=\"roll(this)\">2d8</span> poison and Paralyzed (<span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds)</p>",
      "collapsed": false
    },
    {
      "name": "Web Trap",
      "actions": null,
      "traits": [],
      "description": "<p>A creature hit by the joro spider's web Strike is immobilized and stuck to the nearest surface until it Escapes (DC 25).</p>",
      "collapsed": false
    }
