  "defensiveAbilities": [
    {
      "name": "Biotech",
      "actions": null,
      "traits": [],
      "description": "<p>The biotech of a biotech zombie can be disabled for 1 hour by a creature that succeeds at a DC 18 Medicine  of Life Science Lore check. Attempting to do so can typically be done only while within reach of the zombie and is a 2-action activity that has the manipulate trait. A biotech zombie with disabled biotech is Slowed 1 and can't use any reactions.</p>",
      "collapsed": false
    },
    {
      "name": "Genetic Instability",
      "actions": -1,
      "traits": [],
      "description": "<p>A biotech zombie must use this reaction unless its biotech is disabled</p>\n<p><strong>Trigger</strong> The zombie is reduced to 0 Hit Points</p><hr /><p><strong>Effect</strong> The zombie melts into a caustic pool of biological goo, dealing 2d8 Acid Damage damage in a 10ft Type:emanation (Basic DC 18 Reflex Saving Throw save) and making that area hazardous terrain for 1 minute (1 acid damage). This ability destroys any organic items on the zombie (including biotech).</p>",
      "collapsed": false
    },
    {
      "name": "Void Healing",
      "actions": null,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p>A creature with void healing draws health from void energy rather than vitality energy. It is damaged by vitality damage and is not healed by vitality healing effects. It does not take void damage, and it is healed by void effects that heal undead.</p></p></details></p>",
      "collapsed": false
    }
  ],
