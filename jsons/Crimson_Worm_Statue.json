  "offensiveAbilities": [
    {
      "name": "Thrash",
      "actions": 2,
      "traits": [],
      "description": "<p>The crimson worm statue makes a Strike against each creature in its reach. It can strike up to once with its jaws and any number of times with its tail. Each attack counts toward the worm's multiple attack penalty, but the multiple attack penalty doesn't increase until after it makes all its attacks.</p>",
      "collapsed": false
    },
    {
      "name": "Vomit Worms",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> The statue disgorges a Bore Worm Swarm into an adjacent 10-foot-by-10-foot space. Creatures in the swarm's area are immediately affected by the bore worm swarm's Swarming Bites, after which the bore worm swarm rolls initiative and acts independently before disappearing after <span class=\"roll\" onclick=\"roll(this)\">1d6</span> minutes.</p>",
      "collapsed": false
    }
  ],
