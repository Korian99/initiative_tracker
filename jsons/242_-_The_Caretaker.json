  "offensiveAbilities": [
    {
      "name": "Inhabit Object",
      "actions": 3,
      "traits": [],
      "description": "<p>The Caretaker possess an object of size Large or smaller within 20 feet, making it an animated object (maximum level 1). If the target object is being held by a creature, the bearer can attempt a DC 16 Will save to prevent the possession. The possession ends when the object is destroyed or the Caretaker leaves it. At this point, the Caretaker reappears in the object's square and can't Inhabit an Object again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    }
  ],
