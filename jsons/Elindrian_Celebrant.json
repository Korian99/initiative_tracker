  "offensiveAbilities": [
    {
      "name": "Pain Bond",
      "actions": null,
      "traits": [],
      "description": "<p>A celebrant's painsaw is powered by the heart of another celebrant. If a celebrant is within 30 feet of a painsaw that contains their heart when the painsaw Strikes a creature, the celebrant regains a number of Hit Points equal to their level (typically 4). It's taboo for a celebrant to wield a painsaw made from their own heart or a heart from any celebrant whose death they didn't witness (or cause) themself. A painsaw otherwise functions in all ways like a painglaive but doesn't function with normal batteries. A single celebrant heart functions as a tactical battery when used with a painsaw; it recharges if the celebrant spends 10 minutes in the presence of an elindrian queen.</p>",
      "collapsed": false
    }
