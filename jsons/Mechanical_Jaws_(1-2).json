  "offensiveAbilities": [
    {
      "name": "Jaws",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature walks on the tile.</p>\n<hr />\n<p><strong>Effect</strong> The jaws of the trap snap shut, Striking the triggering creature. The triggering creature is Immobilized until the trap is disabled or a creature succeeds at a <span data-pf2-action=\"forceOpen\" data-pf2-glyph=\"A\" data-pf2-dc=\"12\" data-pf2-show-dc=\"gm\">Athletics</span> check to Force it Open. A creature who critically fails the check to Force it Open instead tightens the trap, dealing <span class=\"roll\" onclick=\"roll(this)\">1d6+3</span> piercing damage to the immobilized creature.</p>",
      "collapsed": false
    }
  ],
