  "offensiveAbilities": [
    {
      "name": "Boiling Rain",
      "actions": 2,
      "traits": [
        "arcane",
        "fire",
        "water"
      ],
      "description": "<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> The scalding mephit calls down a rain boiling water that surrounds them in a 10 foot emanation. Creatures in the area take <span class=\"roll\" onclick=\"roll(this)\">2d8+3</span> fire damage (DC 18 basic Reflex save), and small unattended flames (such as torches) are extinguished.</p>",
      "collapsed": false
    },
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "arcane",
        "fire"
      ],
      "description": "<p>The scalding mephit spits a cloud of steam in a 15 foot cone that deals <span class=\"roll\" onclick=\"roll(this)\">3d6</span> fire damage to each creature within the area (DC 18 basic Reflex save).</p>\n<p>The scalding mephit can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    }
  ],
