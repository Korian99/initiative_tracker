  "offensiveAbilities": [
    {
      "name": "Eye Ray",
      "actions": 2,
      "traits": [],
      "description": "<p>The retriever makes a ranged eye ray Strike against an enemy within 60 feet. On a hit, the retriever chooses one of the four options listed below. The retriever cannot use the same effect in consecutive rounds. Once the retriever has used all four options, the eye ray Strike can't be used for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p><ul><li><strong>Cold</strong> The enemy takes <span class=\"roll\" onclick=\"roll(this)\">2d12+13</span> cold damage</li><li><strong>Electricity</strong> The enemy takes <span class=\"roll\" onclick=\"roll(this)\">2d12+13</span> electricity damage</li><li><strong>Fire</strong> The enemy takes <span class=\"roll\" onclick=\"roll(this)\">2d12+13</span> fire damage</li><li><strong>Petrification</strong> The enemy is targeted by a 6th-rank Petrify using the retriever's innate spell DC (DC 26 Fortitude save).</li></ul>",
      "collapsed": false
    }
