  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "electricity",
        "primal"
      ],
      "description": "<p>The taiga linnorm breathes a 60 foot cone of electrified vapor, dealing <span class=\"roll\" onclick=\"roll(this)\">20d6</span> electricity damage to creatures in the area (DC 41 basic Reflex save). The electrified mist persists for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds, dealing <span class=\"roll\" onclick=\"roll(this)\">6d6</span> electricity damage (DC 41 basic Reflex save) to each creature that ends its turn in the mist.</p>\n<p>The taiga linnorm can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Taiga Linnorm Venom",
      "actions": null,
      "traits": [
        "electricity",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 42 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 10 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">7d6</span> electricity damage and Drained 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">10d6</span> electricity damage and Drained 2 (1 round)</p>",
      "collapsed": false
    }
  ],
