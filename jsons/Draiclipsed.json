  "offensiveAbilities": [
    {
      "name": "Consume Light",
      "actions": 1,
      "traits": [
        "darkness"
      ],
      "description": "<p>The draiclipsed opens their mouth and sucks in a magical light, consuming it to fuel their own powers. The draiclipsed attempts a counteract check against one magical light effect within 60 feet (+15 counteract modifier). If successful, the draiclipsed becomes ringed in diffuse light, becoming photonic for the next 24 hours. While a draiclipsed is photonic, they're Concealed.</p>",
      "collapsed": false
    },
    {
      "name": "Cull the Betrayers",
      "actions": null,
      "traits": [],
      "description": "<p>Whenever a draiclipsed would deal void damage to an undead or other creature with void healing, that void damage becomes cold damage instead.</p>",
      "collapsed": false
    },
    {
      "name": "Darkness Falls",
      "actions": 2,
      "traits": [
        "darkness",
        "electricity",
        "void"
      ],
      "description": "<p><strong>Requirements</strong> The draiclipsed is photonic</p><hr /><p><strong>Effect</strong> The draiclipsed releases the light they've consumed in a blast of corrupted electromagnetic energy, dealing 3d8 electricity and 3d8 Void Damage damage in a 30ft Type:cone (Basic DC 24 Reflex Saving Throw save). The draiclipsed is no longer photonic.</p>",
      "collapsed": false
    },
    {
      "name": "Gathering Darkness",
      "actions": null,
      "traits": [],
      "description": "<p>If at least one other draiclipsed is within the draiclipsed's eclipse shroud, the draiclipsed's Strikes deal an additional 1d8 Void Damage damage.</p>",
      "collapsed": false
    }
  ],
