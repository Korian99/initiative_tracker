  "offensiveAbilities": [
    {
      "name": "Avalanche",
      "actions": null,
      "traits": [],
      "description": "<p>A non-arabuk creature standing on snow that fails its Reflex save against an arabuk's antler reverberation is knocked Prone. Up to a 20ft Cube of snow in the area of an antler reverberation collapses, dealing 5d6 Bludgeoning Damage damage to adjacent creatures (Basic DC 24 Reflex Saving Throw save). On a slope, this causes the snow and any creatures that fail its save to move downhill 30 feet per round. At the start of its turn, each creature caught in the avalanche takes 3d6 Bludgeoning Damage damage (Basic DC 24 Reflex Saving Throw save) and, on a failure, is still caught in the avalanche.</p>",
      "collapsed": false
    },
    {
      "name": "Clatter",
      "actions": 1,
      "traits": [],
      "description": "<p>The arabuk clatters its antlers together by shaking its head. Until the end of its turn, any creature hit by its antlers must succeed at a DC 22 Fortitude Saving Throw save or become Stunned 1 (Stunned 2 on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Glacial Stride",
      "actions": 2,
      "traits": [],
      "description": "<p>The arabuk Strides twice with a +10-foot circumstance bonus to Speed, ignoring difficult terrain caused by ice, snow, or other arctic conditions.</p>",
      "collapsed": false
    }
  ],
