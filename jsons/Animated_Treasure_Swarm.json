  "offensiveAbilities": [
    {
      "name": "Blade Storm",
      "actions": 1,
      "traits": [
        "magical"
      ],
      "description": "<p>Each enemy in the animated treasure swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">6d6</span> piercing or <span class=\"roll\" onclick=\"roll(this)\">6d6</span> slashing damage (DC 25 basic Reflex save).</p>",
      "collapsed": false
    },
    {
      "name": "One with the Hoard",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The animated treasure swarm is adjacent to Viseldron's hoard</p><hr /><p><strong>Effect</strong> The animated treasure swarm enters Viseldron's hoard, then emerges from the hoard at any other point in, or adjacent to, the hoard's area.</p>",
      "collapsed": false
    },
    {
      "name": "Trash the Place",
      "actions": 1,
      "traits": [
        "magical"
      ],
      "description": "<p>The animated treasure swarm hurls its most fragile components in a destructive barrage, dealing <span class=\"roll\" onclick=\"roll(this)\">4d6</span> bludgeoning damage to all creatures in a 20 foot burst within 100 feet (DC 25 basic Reflex save).</p>",
      "collapsed": false
    }
  ],
