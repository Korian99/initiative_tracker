    {
      "name": "Faithful Weapon",
      "actions": null,
      "traits": [],
      "description": "<p>While the divine warden wields the favored weapon of its patron deity, that weapon gains the effect of a <em>greater striking rune</em>.</p>",
      "collapsed": false
    },
    {
      "name": "Instrument of Faith",
      "actions": null,
      "traits": [],
      "description": "<p>The divine warden is a beacon for its deity's faith. A cleric of the divine warden's patron deity can channel a Heal spell through a divine warden they can see within 60 feet. The cleric determines any targets or area for the spell as if they were standing in the divine warden's space.</p>",
      "collapsed": false
    }
  ],
