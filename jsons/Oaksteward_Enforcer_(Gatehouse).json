          "castingTime": "2",
          "duration": "1 minute",
          "range": "touch",
          "area": "",
          "targets": "1 willing creature",
          "save": "",
          "description": "<p>Choose one of the target's unarmed attacks. You cause that unarmed attack to shine with primal energy. The unarmed attack becomes a +1 striking unarmed attack, gaining a +1 item bonus to attack rolls and increasing the number of damage dice to two if it had only one.</p>\n",
          "cast": false,
          "cost": "",
