  "offensiveAbilities": [
    {
      "name": "Death Drider Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p>The drained condition persists after the poison's duration ends</p>\n<p><strong>Saving Throw</strong> DC 32 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">2d8</span> poison damage and Drained 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">3d8</span> poison damage and Drained 2 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">4d8</span> poison damage and drained 2 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Hungering Web",
      "actions": null,
      "traits": [],
      "description": "<p>A creature hit by a death drider's web attack is Immobilized and stuck to the nearest surface (Escape DC 31). Each round thereafter until it breaks free, the creature takes <span class=\"roll\" onclick=\"roll(this)\">3d6</span> piercing damage(DC 31 basic Reflex save) and, on a failed save, is exposed to death drider venom.</p>",
      "collapsed": false
    }
  ],
