  "offensiveAbilities": [
    {
      "name": "Squirt Blood",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per day</p>\n<hr />\n<p><strong>Effect</strong> The ikeshti squirts blood from one of their eyes at a target within 30 feet. The target must attempt a DC 18 Fortitude save or become Sickened 1 (Sickened 2 on a critical failure).</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Ikeshti young are near-mindless carnivores. They are watched over by brood-minders, male ikeshtis with a talent for influencing the ravenous spawn, who protect the tiny creatures until they grow into responsible adults.</p>\n<hr />\n<p>Ikeshtis are reptilian humanoids native to Akiton's wastelands. Smaller than Golarion's iruxi, ikeshtis organize around distinct societal roles.</p>",
  "recallKnowledge": "Society, DC: 16",
