  "offensiveAbilities": [
    {
      "name": "Rip Flesh",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> A jinkin has a creature Grabbed with their pincer claw</p>\n<hr />\n<p><strong>Effect</strong> The jinkin forcefully pulls the pincer claw out of the creature, ripping flesh and cackling in sadistic glee. The creature takes <span class=\"roll\" onclick=\"roll(this)\">1d8</span> piercing damage and is no longer grabbed.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The jinkin deals <span class=\"roll\" onclick=\"roll(this)\">1d6</span> extra precision damage to Off-Guard creatures.</p></details>",
      "collapsed": false
    },
    {
      "name": "Tinker",
      "actions": null,
      "traits": [
        "curse",
        "primal"
      ],
      "description": "<p>A group of six jinkins can work together for an hour to imbue an item with a curse at a range of 60 feet. While this process is lengthy, it's also unobtrusive and can be performed while Hiding. Jinkins prefer to use this ability on magic items. The curse makes the item unreliable (DC 5 Flat check or waste any action to Interact with or Activate the item), adds a bizarre requirement to use the item, or imparts some other curse of a similar caliber.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [
    {
      "name": "Primal Innate Spells",
      "type": "innate",
      "bonus": 9,
      "dc": 17,
      "focusPoints": {
