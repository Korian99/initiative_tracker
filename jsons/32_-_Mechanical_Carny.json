  "defensiveAbilities": [
    {
      "name": "Haywire",
      "actions": null,
      "traits": [],
      "description": "<p>A severely damaged mechanical carny has a chance of malfunctioning. If a mechanical carny has 15 or fewer Hit Points at the start of its turn, it must succeed at a DC 5 Flat check or go haywire. A haywire mechanical carny wildly attacks the nearest living creature, or the nearest object if no creatures are nearby. It takes a -1 circumstance penalty to Strikes but deals an additional <span class=\"roll\" onclick=\"roll(this)\">1d6</span> bludgeoning damage plus Knockdown. This effect lasts 10 minutes or until the mechanical carny is destroyed.</p>\n<p>Effect: Haywire</p>",
      "collapsed": false
    }
