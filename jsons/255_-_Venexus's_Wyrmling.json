  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "arcane",
        "cold"
      ],
      "description": "<p>The wyrmling breathes a cloud of frost that deals <span class=\"roll\" onclick=\"roll(this)\">6d6</span> cold damage in a 30 foot cone (DC 22 basic Reflex save). They can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The wyrmling makes two claw Strikes and one tail Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>When the wyrmling scores a critical hit with a Strike, they recharge their Breath Weapon.</p>",
      "collapsed": false
    },
    {
      "name": "Ice Climb",
      "actions": null,
      "traits": [],
      "description": "<p>A white dragon can climb on ice as though they had the listed climb Speed. They ignore difficult terrain and greater difficult terrain from ice and snow and don't risk falling when crossing ice.</p>",
      "collapsed": false
    }
