    {
      "name": "Burn Alive",
      "actions": 1,
      "traits": [
        "fire"
      ],
      "description": "<p>The statue grinds a creature it has Grabbed or Restrained into the red-hot coals of its brazier. The target takes <span class=\"roll\" onclick=\"roll(this)\">3d8</span> fire plus <span class=\"roll\" onclick=\"roll(this)\">1d8</span> persistent plus fire damage.</p>",
