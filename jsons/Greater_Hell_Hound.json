      "actions": null,
      "traits": [],
      "description": "<p>The greater hell hound's Strikes deal <span class=\"roll\" onclick=\"roll(this)\">1d8</span> extra damage to creatures within the reach of at least two of their allies.</p>",
      "collapsed": false
    }
