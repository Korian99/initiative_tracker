  "offensiveAbilities": [
    {
      "name": "Crush Chitin",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The khravgodon has a creature Grabbed or Restrained</p>\n<hr />\n<p><strong>Effect</strong> The khravgodon bites the creature, dealing <span class=\"roll\" onclick=\"roll(this)\">2d12+9</span> piercing damage (DC 28 basic Fortitude save) that ignores the first 5 of the target's Hardness or resistance to physical damage. On a failed save, the target also takes a -2 circumstance penalty to AC for 1 round.</p>\n<p>Effect: Crush Chitin</p>",
      "collapsed": false
    },
    {
      "name": "Grasping Tail",
      "actions": null,
      "traits": [],
      "description": "<p>A khravgodon can drag a Large or smaller creature it has Grabbed with its tail along with it when it Strides.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Few creatures can shrug off an ankhrav's acid and crunch its chitin like a khravgodon.</p>\n<hr />\n<p>Few creatures have survived as long and in as many environments as the opossum.</p>",
