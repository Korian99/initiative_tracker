  "offensiveAbilities": [
    {
      "name": "Hellfire Breath",
      "actions": 1,
      "traits": [
        "divine",
        "fire",
        "unholy"
      ],
      "description": "<p>The hell hound breathes flames that deal <span class=\"roll\" onclick=\"roll(this)\">4d6</span> fire damage to all creatures in a 15 foot cone (DC 19 basic Reflex save).</p>\n<p>The hell hound can't use Hellfire Breath again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds. If the hell hound would take fire damage or be targeted by a fire effect, their Hellfire Breath recharges.</p>",
      "collapsed": false
    },
    {
      "name": "Pack Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The hell hound's Strikes deal <span class=\"roll\" onclick=\"roll(this)\">1d4</span> extra damage to creatures within the reach of at least two of the hell hounds' allies.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>A hell hound's appearance dismisses any doubts as to their infernal origins—flesh the color of burning pitch, teeth as sharp as any fiend's pitchfork, and a shroud of ever-burning hellfire are all trademark features.</p>\n<hr />\n<p>Hell hounds are fiendish, extraplanar canines hailing from the Pit that can hunt down quarry and breathe supernatural gouts of flame. They are temperamental and quick to exhibit aggressive behavior.</p>",
  "recallKnowledge": "Arcana, Nature, Religion, DC: 18",
