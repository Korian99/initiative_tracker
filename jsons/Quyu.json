  "offensiveAbilities": [
    {
      "name": "Cruel Dissection",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> A creature is Grabbed or Restrained by the quyu's jaws or is Fascinated with the quyu</p><hr /><p><strong>Effect</strong> The quyu makes a claw Strike against the required creature. If the attack hits, that creature also takes 2d6 Persistent,bleed Damage damage.</p>",
      "collapsed": false
    },
    {
      "name": "Facade Form",
      "actions": 1,
      "traits": [
        "concentrate",
        "occult",
        "polymorph"
      ],
      "description": "<p>The quyu compresses and reshapes themself to appear as an adorable, helpless creature. They have an automatic result of 35 on Deception checks and DCs to pass as the creature. While in this form, the quyu is Tiny and can't attack, and their pathetic gaze aura is active. The quyu can Dismiss this form.</p>",
      "collapsed": false
    }
