    {
      "name": "Najra Lizard Venom",
      "actions": null,
      "traits": [],
      "description": "<p>The creature is extremely thirsty and can't quench its thirst while poisoned</p>\n<p><strong>Saving Throw</strong> DC 21 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 4 hours</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d4</span> poison damage, Fatigued, and <span class=\"roll\" onclick=\"roll(this)\">1d4</span> damage that can't be recovered until the creature quenches its thirst (1 round)</p>\n<p><strong>Stage 2</strong> as stage 1 (1 hour)</p>",
      "collapsed": false
    },
    {
      "name": "Najra Swarm Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The najra lizard's melee Strikes deal <span class=\"roll\" onclick=\"roll(this)\">1d6</span> precision damage to creatures sharing a square with more than one najra lizard.</p>",
      "collapsed": false
    }
