  "offensiveAbilities": [
    {
      "name": "Corrupting Gaze",
      "actions": 2,
      "traits": [],
      "description": "<p>The ghost stares at a creature it can see within 30 feet. The target takes <span class=\"roll\" onclick=\"roll(this)\">6d6</span> void damage with a DC 30 basic Will save.</p>\n<p>A creature that fails its save is also Stupefied 1 for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Phantom Blight",
      "actions": null,
      "traits": [
        "mental",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 30 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">3d6</span> mental damage and Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">4d6</span> mental damage and clumsy 1 (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">5d6</span> mental damage and clumsy 1, plus the creature takes a –2 penalty to saving throws against Ayrzul's Blight for 24 hours (1 round)</p>",
      "collapsed": false
    }
  ],
