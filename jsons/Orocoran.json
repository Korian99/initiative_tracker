  "offensiveAbilities": [
    {
      "name": "Hallucinate",
      "actions": null,
      "traits": [
        "mental"
      ],
      "description": "<p>An orocoran's stomach fluids are laced with hallucinogens due to their consumption of the ichor-like birthing fluids expelled by Aucturn during the hatching of the Newborn.</p>\n<p>A creature hit with the projectile vomit must succeed at a DC 24 Will Saving Throw save or be Confused for 1 round (1d4 rounds on a critical failure).</p>",
      "collapsed": false
    },
    {
      "name": "Lick Wounds",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Requirements</strong> A creature within reach of the orocoran's proboscis is taking persistent bleed damage</p><hr /><p><strong>Effect</strong> The orocoran flicks out their proboscis and sups on the flowing blood of their enemy. The orocoran regains Hit Points equal to the target's persistent bleed value.</p>",
      "collapsed": false
    },
    {
      "name": "Spew Vomit",
      "actions": 2,
      "traits": [
        "acid"
      ],
      "description": "<p>The orocoran spews vomit in a 15ft Type:cone, dealing 3d6 Acid Damage damage (Basic DC 24 Will Saving Throw save). Creatures that fail their save are Confused for 1 round (1d4 rounds on a critical failure). This confusion is a mental effect.</p>",
      "collapsed": false
    }
  ],
