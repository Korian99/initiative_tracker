  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p>The dragon breathes a blast of magma that deals <span class=\"roll\" onclick=\"roll(this)\">9d6</span> fire damage and <span class=\"roll\" onclick=\"roll(this)\">4d12</span> bludgeoning damage in a 40 foot cone (DC 33 basic Reflex save).</p>\n<p>They can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one horn Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon recharges their Breath Weapon whenever they score a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Volcanic Purge",
      "actions": 1,
      "traits": [],
      "description": "<p>If the next action the dragon uses is Breath Weapon, the magma clings to those it damages. Each creature that fails its save against the Breath Weapon takes <span class=\"roll\" onclick=\"roll(this)\">4d6</span> persistent plus fire damage, and as long as it has this persistent fire damage, it also takes a -10-foot status penalty to its Speeds.</p>",
      "collapsed": false
    }
  ],
