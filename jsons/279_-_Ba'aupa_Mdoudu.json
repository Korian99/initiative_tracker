    {
      "name": "Reactive",
      "actions": null,
      "traits": [],
      "description": "<p>A ba'aupa mdoudu gains an additional reaction at the start of its turn but can use this reaction only to Slime Squirt.</p>",
      "collapsed": false
    },
    {
      "name": "Skeleton Sense 60 feet",
      "actions": null,
      "traits": [],
      "description": "<p>Aba'aupa mdoudu can sense the presence of bones and skeletons within 60 feet; this is a precise sense when detecting dead bones but an imprecise one when detecting living bones.</p>",
      "collapsed": false
    },
    {
      "name": "Slime Squirt",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature inflicts slashing or piercing damage on the ba'aupa mdoudu with a melee Strike</p><hr /><p><strong>Effect</strong> The attacking creature takes <span class=\"roll\" onclick=\"roll(this)\">2d10</span> acid damage.</p>",
      "collapsed": false
    }
  ],
