        }
      ],
      "effects": [],
      "usedAttributeToHit": "dexterity",
      "usedAttributeDamage": "strength",
      "toHitModifications": [],
      "damageModifications": []
    }
  ],
  "offensiveAbilities": [
    {
      "name": "Malevolent Possession",
      "actions": 2,
      "traits": [
        "divine",
        "incapacitation",
        "mental",
        "possession"
      ],
      "description": "<p>Jarelle attempts to possess an adjacent corporeal creature. This has the same effect as the Possession spell (with a spell DC of 22), except since Jarelle doesn't have a physical body, she is unaffected by that restriction of the spell.</p>",
      "collapsed": false
    },
    {
      "name": "Poisoned Breath",
      "actions": 2,
      "traits": [
        "divine",
        "poison"
      ],
      "description": "<p>Jarelle exhales a 15 foot cone of toxic mist that deals <span class=\"roll\" onclick=\"roll(this)\">5d6</span> poison damage (DC 22 basic Fortitude save; on a critical failure, the target is also Enfeebled 1 for 24 hours).</p>\n<p>She then can't use Poisoned Breath again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    }
  ],
