  "offensiveAbilities": [
    {
      "name": "Frightening Display",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The gorilla beats its chest in a terrifying display. Creatures within 30 feet must attempt a DC 22 Will save.</p>\n<p>While a creature is Frightened by this ability, it is Off-Guard to the gigantopithecus.</p>\n<hr />\n<p><strong>Critical Success</strong> No effect and temporarily immune for 1 minute.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature is Frightened 1.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 2.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>These fierce kin of orangutans are three times heavier than a gorilla.</p>\n<hr />\n<p>While many apes exhibit peaceful or reclusive behavior, gorillas can be territorial, and the megaprimatus is especially aggressive and dangerous.</p>",
