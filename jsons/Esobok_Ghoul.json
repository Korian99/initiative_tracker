  "offensiveAbilities": [
    {
      "name": "Consume Flesh",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The esobok ghoul is adjacent to the corpse of a creature that died within the last hour.</p>\n<hr />\n<p><strong>Effect</strong> The ghoul devours a chunk of the corpse and regains <span class=\"roll\" onclick=\"roll(this)\">3d6</span> healing Hit Points.</p>\n<p>It can regain Hit Points from any given corpse only once.</p>",
      "collapsed": false
    },
    {
      "name": "Corrupted Touch",
      "actions": null,
      "traits": [],
      "description": "<p>An esobok ghoul's Strikes deal <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage to living creatures. A creature critically hit by an esobok ghoul's Strike must attempt a DC 18 Fortitude save or become Drained 1 (Drained 2 on a critical failure) as rot spreads throughout their flesh.</p>",
      "collapsed": false
    },
    {
      "name": "Ghoul Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 22 Fortitude save</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> void damage and regains half as many Hit Points from all healing (1 day)</p>\n<p><strong>Stage 3</strong> as stage 2 (1 day)</p>\n<p><strong>Stage 4</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> void damage and gains no benefit from healing (1 day)</p>\n<p><strong>Stage 5</strong> as stage 4 (1 day)</p>\n<p><strong>Stage 6</strong> dead, and rises as a ghoul the next midnight.</p>",
      "collapsed": false
    },
    {
      "name": "Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>Any living, non-elf creature hit by a ghoul's attack must succeed at a DC 22 Fortitude save or become Paralyzed.</p>\n<p>It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>",
      "collapsed": false
    },
    {
      "name": "Pounce",
      "actions": 1,
      "traits": [],
      "description": "<p>The esobok ghoul Strides and then makes a claw Strike. If it began this action hidden, it remains hidden until after the Strike.</p>",
      "collapsed": false
    }
  ],
