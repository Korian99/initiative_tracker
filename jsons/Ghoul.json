  "offensiveAbilities": [
    {
      "name": "Consume Flesh",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p><strong>Requirements</strong> The ghoul is adjacent to the corpse of a creature that died within the last hour.</p><hr /><p><strong>Effect</strong> The ghoul devours a chunk of the corpse and regains <span class=\"roll\" onclick=\"roll(this)\">1d6</span> healing Hit Points.</p>\n<p>It can regain Hit Points from any given corpse only once.</p>",
      "collapsed": false
    },
    {
      "name": "Ghoul Fever",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 15 Fortitude save</p>\n<hr />\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> void damage and regains half as many Hit Points from all healing (1 day)</p>\n<p><strong>Stage 3</strong> as stage 2 (1 day)</p>\n<p><strong>Stage 4</strong> <span class=\"roll\" onclick=\"roll(this)\">2d6</span> void damage and gains no benefit from healing (1 day)</p>\n<p><strong>Stage 5</strong> as stage 4 (1 day)</p>\n<p><strong>Stage 6</strong> dead, and rises as a Ghoul the next midnight.</p>",
      "collapsed": false
    },
    {
      "name": "Paralysis",
      "actions": null,
      "traits": [
        "incapacitation",
        "occult"
      ],
      "description": "<p>Any living, non-elf creature hit by a ghoul's attack must succeed at a DC 15 Fortitude save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.</p>",
      "collapsed": false
    },
    {
      "name": "Swift Leap",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The ghoul jumps up to half its Speed. This movement doesn't trigger reactions.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Ghouls are ravenous undead who haunt graveyards and eat corpses.</p>\n<hr />\n<p>Few creatures are more ubiquitous to sinister locations such as lonely graveyards and ruined crypts than the flesh-eating undead known as ghouls.</p>",
  "recallKnowledge": "Religion, DC: 15",
