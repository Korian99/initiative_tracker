    {
      "name": "Beestings",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p>The creature must attempt a DC 16 Fortitude save. Those who fail take <span class=\"roll\" onclick=\"roll(this)\">1d4</span> poison damage and are Clumsy 1 for 1 minute.</p>",
      "collapsed": false
    },
    {
      "name": "Swarming Stings",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">1d4</span> piercing damage (DC 16 basic Reflex save). The first time each round a creature fails the save and takes piercing damage, it also suffers the effect of beestings.</p>\n<p>Whenever the bee swarm uses this ability, the swarm takes 1 damage.</p>",
      "collapsed": false
    }
