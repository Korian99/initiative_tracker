  "offensiveAbilities": [
    {
      "name": "Memory Drain",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The hollow husk has a creature Grabbed or Restrained</p>\n<hr />\n<p><strong>Effect</strong> Memories flow from the grabbed creature into the empty void that is the hollow husk's mind. The hollow husk deals the creature <span class=\"roll\" onclick=\"roll(this)\">3d6</span> mental damage, and the creature must attempt a DC 16 Will save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is Stupefied 1 for 1 minute.</p>\n<p><strong>Critical Failure</strong> The creature takes full damage and is Stupefied 2 for 1 minute.</p>",
      "collapsed": false
    }
  ],
