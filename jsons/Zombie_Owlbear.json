  "offensiveAbilities": [
    {
      "name": "Ground Slam",
      "actions": 2,
      "traits": [
        "attack"
      ],
      "description": "<p><strong>Requirements</strong> The zombie owlbear has a creature Grabbed or Restrained with its talons</p>\n<hr />\n<p><strong>Effect</strong> The zombie owlbear repeatedly slams the creature into the ground. This deals <span class=\"roll\" onclick=\"roll(this)\">1d10+7</span> bludgeoning damage (DC 20 basic Fortitude save). On a critical failure, the creature is Stunned 1, and on a critical success the creature is no longer grabbed or restrained.</p>",
      "collapsed": false
    },
    {
      "name": "Horrifying Screech",
      "actions": 1,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The zombie owlbear unleashes a broken, snarling screech that unnerves those who hear it. Each creature in a 60 foot emanation must attempt a DC 19 Will save. Regardless of the result, creatures are temporarily immune for 1 minute.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Fleeing for 1 round and Frightened 3.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Zombie owlbears combine an owlbear's ferocity with mindless undead hatred. Once it draws near, it often stands up, unleashing a guttural, wet roar, before charging into combat without thought of self-preservation.</p>\n<hr />\n<p>Simple to create and varied in purpose, these shambling undead are often used for their strength and endless stamina to conduct boring, repetitive tasks.</p>",
  "recallKnowledge": "Religion, DC: 18",
