    {
      "name": "Aerial Predator",
      "actions": null,
      "traits": [],
      "description": "<p>When a whiptail renkroda has a Medium or smaller creature Grabbed, its Grab doesn't end if it moves away. Instead, when it moves, it carries the grabbed creature with it.</p>",
      "collapsed": false
    },
    {
      "name": "Fling",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> A creature is Grabbed in the whiptail renkroda's tail</p><hr /><p><strong>Effect</strong> The whiptail renkroda flings the creature through the air, launching the creature up to 10 feet up from its tail and 30 feet away. The creature takes falling damage accordingly. If the flung creature lands on another creature, the creature it lands on takes the same amount of bludgeoning damage (Basic DC 26 Reflex Saving Throw save).</p>",
      "collapsed": false
    },
    {
      "name": "Terrifying Roar",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The whiptail renkroda bellows ferociously. Each non-renkroda creature within 60 feet must attempt a DC 29 Will Saving Throw save. The creature is then temporarily immune for 10 minutes.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Frightened 1.</p>\n<p><strong>Failure</strong> The creature is Frightened 2.</p>\n<p><strong>Critical Failure</strong> The creature is Frightened 3.</p>",
