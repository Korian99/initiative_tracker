    {
      "name": "Breathe Shrapnel",
      "actions": 2,
      "traits": [
        "arcane",
        "metal"
      ],
      "description": "<p>The metal scamp breathes a 15 foot cone of jagged metal flakes that deals <span class=\"roll\" onclick=\"roll(this)\">2d4</span> slashing plus <span class=\"roll\" onclick=\"roll(this)\">1d4</span> bleed damage to each creature within the area (DC 17 basic Reflex save).</p>\n<p>The metal scamp can't Breathe Shrapnel again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
