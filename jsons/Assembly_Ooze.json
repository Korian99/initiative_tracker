  "offensiveAbilities": [
    {
      "name": "Assemble",
      "actions": null,
      "traits": [],
      "description": "<p>Over the course of 1 minute, the assembly ooze crafts a random piece of gear (rolling a 1d6: 1–armor, 2–shield, 3–weapon, 4–armor upgrade, 5–weapon upgrade, or 6–tech item) using the UPBs stored inside of it. An assembly ooze can craft items with a cost up to the UPBs stored, but with an item level and Bulk of no greater than 4 each.</p>",
      "collapsed": false
    },
    {
      "name": "Disassemble",
      "actions": 2,
      "traits": [],
      "description": "<p>The assembly ooze engulfs an adjacent, unattended piece of gear of no more than 4 Bulk, deconstructing it into its component parts. The ooze gains a number of UPBs equal to the item's price in credits. An assembly ooze can hold up to 1,000 UPBs at a time.</p>",
      "collapsed": false
    },
    {
      "name": "Sticky Disarm",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The assembly ooze's last action was a successful pseudopod Strike</p><hr /><p><strong>Effect</strong> The ooze attempts to Disarm options=sticky disarm the creature it hit. It gains a +4 status bonus to the Athletics check. This attempt neither applies nor counts toward the ooze's multiple attack penalty.</p>",
      "collapsed": false
    }
  ],
