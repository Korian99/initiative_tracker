    {
      "name": "Greataxe",
      "quantity": 1,
      "description": "<p>This large battle axe is too heavy to wield with only one hand. Many greataxes incorporate two blades, and they are often \"bearded,\" having a hook at the bottom to increase the strength of their chopping power.</p>",
      "level": 0,
      "price": "2 gp ",
