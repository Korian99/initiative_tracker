  "offensiveAbilities": [
    {
      "name": "Wasting Wheeze",
      "actions": -1,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Frequency</strong> once per <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds</p>\n<p><strong>Trigger</strong> The headless spore sheep takes a critical hit or is reduced to 0 Hit Points</p>\n<hr />\n<p><strong>Effect</strong> The headless spore sheep exhales a cloud of spores through its neck. Adjacent living creatures take <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison damage and are Sickened 1 unless they succeed at a DC 18 Fortitude save.</p>",
      "collapsed": false
    },
    {
      "name": "Zombie Rot",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p>An infected creature can't heal damage it takes from zombie rot until it has been cured of the disease.</p>\n<hr />\n<p><strong>Saving Throw</strong> DC 18 Fortitude save</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (1 day)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 4</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> void damage (1 day)</p>\n<p><strong>Stage 5</strong> dead, rising as a plague zombie immediately</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Plague zombies are infested with hideous contagions.</p>\n<hr />\n<p>A zombie's only desire is to consume the living. Unthinking and ever-shambling harbingers of death, zombies stop only when they're destroyed.</p>",
