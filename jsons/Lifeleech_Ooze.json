  "defensiveAbilities": [
    {
      "name": "Life Blindness",
      "actions": null,
      "traits": [],
      "description": "<p>A lifeleech ooze can only detect living and undead creatures. It has no other sensory abilities. When injured by vitality damage, a lifeleech ooze's senses are overwhelmed, and it automatically becomes Blinded until the end of its next turn.</p>",
      "collapsed": false
    },
    {
      "name": "Share Space",
      "actions": null,
      "traits": [],
      "description": "<p>A lifeleech ooze can share the space of up to four medium or smaller creatures without squeezing, so long as it has room to retain its original shape.</p>",
      "collapsed": false
    },
    {
      "name": "Strip Flesh",
      "actions": null,
      "traits": [],
      "description": "<p>Any living creature that begins its turn sharing the same space as a lifeleech ooze takes 3d6 Void Damage damage, with a Basic DC 24 Fortitude Saving Throw save.</p>",
      "collapsed": false
    },
    {
      "name": "Void Healing",
      "actions": null,
      "traits": [],
      "description": "<p><details><summary>See rules...</summary>\n<p><p>A creature with void healing draws health from void energy rather than vitality energy. It is damaged by vitality damage and is not healed by vitality healing effects. It does not take void damage, and it is healed by void effects that heal undead.</p></p></details></p>",
      "collapsed": false
    }
  ],
