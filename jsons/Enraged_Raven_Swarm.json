    {
      "name": "Swarming Claws",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the raven swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">2d8</span> piercing damage (DC 21 basic Reflex save). Creatures that fail this save also take 3 bleed damage</p>\n<p>damage.</p>",
      "collapsed": false
