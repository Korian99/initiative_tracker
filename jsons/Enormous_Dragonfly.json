  "offensiveAbilities": [
    {
      "name": "Clutch",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The enormous dragonfly has a Large or smaller creature Grabbed in its mandibles</p>\n<p><strong>Effect</strong> The dragonfly tries to transfer the grabbed creature to be clutched by its legs. The enormous dragonfly attempts an Athletics check against the creature's Reflex DC. On a success, it transfers the creature (which remains grabbed) to its legs, freeing its mandibles to attack. The dragonfly can have only one creature clutched at a time.</p>",
      "collapsed": false
    },
    {
      "name": "Snatch",
      "actions": null,
      "traits": [],
      "description": "<p>The enormous dragonfly can Fly at half Speed while it has a creature Grabbed or Restrained by Clutch, carrying that creature along with it.</p>",
      "collapsed": false
    },
    {
      "name": "Swoop",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragonfly Flies up to its Speed and makes one mandible Strike at any point during that movement.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>These buzzing insects are the size of a small horse. They are ambush predators known to hunt beasts and humanoids alike, capable of using impressive aerial acrobatics to swoop down from above and snatch away their prey.</p>",
  "recallKnowledge": "Nature, DC: 26",
