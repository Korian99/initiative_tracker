    {
      "name": "Kaukariki Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 15 Fortitude Saving Throw</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> 1d4 Poison Damage damage and Clumsy 1 (1 round)</p>\n<p><strong>Stage 2</strong> 1d6 Poison Damage damage and Clumsy 2 (1 round)</p>\n<p><strong>Stage 3</strong> 2d4 Poison Damage damage and clumsy 2 (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Screaming Frenzy",
      "actions": 2,
      "traits": [
        "auditory",
        "emotion",
        "fear",
        "mental"
      ],
      "description": "<p>The kaukariki starts a frenzy of screaming, involving other nearby kaukarikis. The kaukariki attempts a single Intimidation check to Demoralize all enemies within 30 feet. Any other kaukariki within 30 feet can use its reaction to add a cumulative +1 circumstance bonus to this Demoralize attempt (to a maximum of +4). The kaukariki can't use this ability again for 1d4 rounds, and kaukarikis that used their reactions to grant a bonus count as having used their Screaming Frenzy ability.</p>",
      "collapsed": false
    },
    {
      "name": "Stone Barrage",
      "actions": 2,
      "traits": [],
      "description": "<p><strong>Requirements</strong> the kaukariki used Screaming Frenzy within the last round</p><hr /><p><strong>Effect</strong> The kaukariki Throws Rocks four times, applying its multiple attack penalty normally.</p>",
      "collapsed": false
    },
