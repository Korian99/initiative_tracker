  "offensiveAbilities": [
    {
      "name": "Eviscerate",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p>Ixirizmid performs a swift and painful surgery on a creature it has grabbed or restrained, or who's otherwise immobilized. They roll a Medicine check against the target's Fortitude DC. Regardless of the result, the target then becomes temporarily immune to Eviscerate for 24 hours.</p>\n<hr />\n<p><strong>Critical Success</strong> The target takes <span class=\"roll\" onclick=\"roll(this)\">8d6</span> slashing damage, is Slowed 1 for 1 round, and becomes Clumsy 1, Enfeebled 1, or Stupefied 1 (the mi-go chooses) for 24 hours.</p>\n<p><strong>Success</strong> The target takes <span class=\"roll\" onclick=\"roll(this)\">5d6</span> slashing damage and is Slowed 1 for 1 round by the pain.</p>\n<p><strong>Failure</strong> The target takes <span class=\"roll\" onclick=\"roll(this)\">3d6</span> slashing damage.</p>\n<p><strong>Critical Failure</strong> The target takes no damage.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>Ixirizmid deals an additional <span class=\"roll\" onclick=\"roll(this)\">1d6</span> precision damage to Off-Guard creatures.</p></details>",
      "collapsed": false
    }
  ],
