  "offensiveAbilities": [
    {
      "name": "Mauler",
      "actions": null,
      "traits": [],
      "description": "<p>A painted stag gains a +5 circumstance bonus to damage rolls against creatures it has grabbed.</p>",
      "collapsed": false
    },
    {
      "name": "Painted Dance",
      "actions": 2,
      "traits": [
        "auditory",
        "mental",
        "plant",
        "primal",
        "visual"
      ],
      "description": "<p>The stag shakes the wooden plating along its body in a cacophonous clatter that sets its painted patterns dancing. All creatures within 60 feet of the painted stag who can see or hear it must attempt a DC 28 Will save; a creature Grabbed by the stag takes a –4 circumstance penalty to its save. Regardless of the result of its save, each creature is temporarily immune for 1 hour.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is Fascinated by the painted stag for 1 round.</p>\n<p><strong>Failure</strong> The creature is Stunned 2 and fascinated by the painted stag for as long as it's stunned.</p>\n<p><strong>Critical Failure</strong> As failure, except Stunned 4.</p>",
      "collapsed": false
    }
  ],
