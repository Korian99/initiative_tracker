  "offensiveAbilities": [
    {
      "name": "Giant Ant Venom",
      "actions": null,
      "traits": [
        "poison"
      ],
      "description": "<p>A target that takes piercing damage from the giant ant's stinger Strike must succeed at a DC 18 Fortitude save or take <span class=\"roll\" onclick=\"roll(this)\">1d10</span> poison damage.</p>",
      "collapsed": false
    },
    {
      "name": "Haul Away",
      "actions": 1,
      "traits": [],
      "description": "<p>If the giant ant has a creature grabbed or restrained with its mandibles, it can spend this action to Stride up to its speed, carrying the creature with it. At the end of the Stride, place the creature in any open square adjacent to the giant ant.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Giant ants form vast underground colonies, excavating deep burrows or infesting existing caverns. Giant ants look identical to their smaller kin, but their size makes them a deadly threat to farms and travelers alike.</p>",
