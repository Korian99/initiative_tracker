    },
    {
      "name": "Record Video",
      "actions": 1,
      "traits": [],
      "description": "<p>The nodocite surveiller records or stops recording its surroundings, automatically transmitting everything it records to the <em>Wreck of the Returned</em>. Destroying or removing a nodocite surveiller's recording capabilities requires a successful DC 14 Thievery  check to Disable device.</p>",
      "collapsed": false
