  "offensiveAbilities": [
    {
      "name": "Breath Weapon",
      "actions": 2,
      "traits": [
        "fire",
        "primal"
      ],
      "description": "<p>The dragon breathes a blast of magma that deals <span class=\"roll\" onclick=\"roll(this)\">5d6</span> fire damage and <span class=\"roll\" onclick=\"roll(this)\">3d12</span> bludgeoning damage in a 30 foot cone (DC 28 basic Reflex save).</p>\n<p>They can't use Breath Weapon again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Frenzy",
      "actions": 2,
      "traits": [],
      "description": "<p>The dragon makes two claw Strikes and one horn Strike in any order.</p>",
      "collapsed": false
    },
    {
      "name": "Draconic Momentum",
      "actions": null,
      "traits": [],
      "description": "<p>The dragon recharges their Breath Weapon whenever they score a critical hit with a Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Magma Swim",
      "actions": null,
      "traits": [],
      "description": "<p>A magma dragon's swim Speed functions only when the dragon is swimming through magma or molten lava.</p>",
      "collapsed": false
    }
  ],
