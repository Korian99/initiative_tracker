  "offensiveAbilities": [
    {
      "name": "Giant Wasp Venom",
      "actions": null,
      "traits": [
        "incapacitation",
        "poison"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 22 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> no effect (1 round)</p>\n<p><strong>Stage 2</strong> Clumsy 2 (1 round)</p>\n<p><strong>Stage 3</strong> Paralyzed (1 round)</p>",
      "collapsed": false
    },
    {
      "name": "Implant Eggs",
      "actions": 1,
      "traits": [],
      "description": "<p>The Vespiria lays eggs in an adjacent creature that is Paralyzed or Unconscious, exposing it to wasp larva disease.</p>",
      "collapsed": false
    },
    {
      "name": "To Me, My Minions",
      "actions": 1,
      "traits": [
        "concentrate",
        "divine",
        "unholy"
      ],
      "description": "<p>The vespiria queen has complete control over wasps within 30 feet. All giant wasps or wasp swarms in range can make a free attack on a target within melee range as normal.</p>",
      "collapsed": false
    },
    {
      "name": "Wasp Larva",
      "actions": null,
      "traits": [
        "disease"
      ],
      "description": "<p><strong>Saving Throw</strong> DC 22 Fortitude save</p>\n<p><strong>Stage 1</strong> carrier with no ill effect (<span class=\"roll\" onclick=\"roll(this)\">1d6</span> days)</p>\n<p><strong>Stage 2</strong> Drained 1 (<span class=\"roll\" onclick=\"roll(this)\">1d3</span> days)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">5d6</span> untyped damage, larva emerges (disease ends)</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [
    {
      "name": "Divine Innate Spells",
