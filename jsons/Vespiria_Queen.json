      "cantrips": [
        {
          "name": "Vitality Lash",
          "type": "cantrip",
          "level": 1,
          "traits": [
            "concentrate",
            "manipulate",
            "vitality"
          ],
          "castingTime": "2",
          "duration": "",
          "range": "30 feet",
          "area": "",
          "targets": "1 creature that is undead or otherwise has void healing",
          "save": "basic fortitude",
          "description": "<p>You demolish the target's corrupted essence with energy from Creation's Forge. You deal <span class=\"roll\" onclick=\"roll(this)\">2d6</span> vitality damage with a basic Fortitude save. If the creature critically fails the save, it is also Enfeebled 1 until the start of your next turn.</p>\n<hr />\n<p><strong>Heightened (+1)</strong> The damage increases by <span class=\"roll\" onclick=\"roll(this)\">1d6</span>.</p>",
          "cast": false,
          "cost": "",
          "primaryCheck": "",
          "secondaryCasters": "",
          "secondaryChecks": "",
          "id": "8lg7wlcbCUEKYCoX"
        }
      ],
      "rituals": [],
      "spellLocations": [],
