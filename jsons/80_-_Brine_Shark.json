    {
      "name": "Deep Plunge",
      "actions": 1,
      "traits": [],
      "description": "<p>The brine shark dives straight down into the water, moving up to twice its swim Speed in a straight vertical line. It can use this ability while grabbing a creature.</p>",
      "collapsed": false
