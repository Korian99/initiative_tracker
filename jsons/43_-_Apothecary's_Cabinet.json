  "offensiveAbilities": [
    {
      "name": "Poison Stock",
      "actions": null,
      "traits": [],
      "description": "<p>When the cabinet hits a creature with its poison bottle Strike, roll <span class=\"roll\" onclick=\"roll(this)\">1d4</span> to determine what kind of poison splashes onto the struck creature:</p>\n<ol>\n<li>nerve poison (Clumsy 1)</li>\n<li>weakening poison (Enfeebled 1)</li>\n<li>noxious poison (Sickened 1)</li>\n<li>clouded mind poison (Stupefied 1).</li>\n</ol>\n<p>The target must attempt a DC 24 Fortitude save.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unafected.</p>\n<p><strong>Success</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison.</p>\n<p><strong>Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">2d6</span> poison and is aficted with the rolled poison's associated condition until the end of its next turn.</p>\n<p><strong>Critical Failure</strong> The creature takes <span class=\"roll\" onclick=\"roll(this)\">2d6</span> poison and is aficted with the rolled poison's associated condition for <span class=\"roll\" onclick=\"roll(this)\">1d4+1</span> rounds.</p>",
      "collapsed": false
    }
