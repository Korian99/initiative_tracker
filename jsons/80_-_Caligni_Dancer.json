  "offensiveAbilities": [
    {
      "name": "Dancer's Curse",
      "actions": 1,
      "traits": [
        "curse",
        "mental",
        "occult"
      ],
      "description": "<p>The caligni dancer touches a foe and curses it.</p>\n<p>If the target fails a DC 18 Will save, it gains Clumsy 1 and Stupefied 1.</p>\n<p>The target is then temporarily immune for 24 hours.</p>\n<p>These conditions persist until the curse is removed. The victim can attempt a new DC 18 Will save once per hour to end the curse.</p>",
      "collapsed": false
    },
