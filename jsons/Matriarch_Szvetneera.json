  "offensiveAbilities": [
    {
      "name": "Icy Protection",
      "actions": null,
      "traits": [],
      "description": "<p>Whenever Szvetneera Casts a Spell with the cold trait, she can choose to grant one of her bodyguards resistance to cold 3 until the beginning of Szvetneera's next turn.</p>\n<p>Effect: Icy Protection</p>",
      "collapsed": false
    },
    {
      "name": "Shackling Cold",
      "actions": 1,
      "traits": [
        "primal",
        "spellshape"
      ],
      "description": "<p>Matriarch Szvetneera uses her mastery of ice magic to hobble a target. If her next action is to Cast a Spell with the cold trait, that spell also gives the target a –10 circumstance penalty to their Speed until the beginning of Szvetneera's next turn if they are affected.</p>\n<p>Effect: Shackling Cold</p>",
      "collapsed": false
    }
