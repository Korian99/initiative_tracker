  "offensiveAbilities": [
    {
      "name": "Pounce",
      "actions": 1,
      "traits": [],
      "description": "<p>The psstpsstmitl Strides and makes a Strike at the end of that movement. If the psstpsstmitl began this action Hidden, it remains hidden until after this ability's Strike.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The psstpsstmitl deals <span class=\"roll\" onclick=\"roll(this)\">2d6</span> extra precision damage to Off-Guard creatures</p></details>",
      "collapsed": false
    },
    {
      "name": "Topple",
      "actions": 2,
      "traits": [],
      "description": "<p>The psstpsstmitl swipes one giant paw across the battlefield in a 30 foot cone. All creatures in the cone must attempt a Reflex save.</p>\n<hr />\n<p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target is pushed 10 feet away from the psstpsstmitl and is knocked Prone</p>\n<p><strong>Failure</strong> The target is pushed 20 feet away from the psstpsstmitl and is knocked prone.</p>\n<p><strong>Critical Failure</strong> As failure, and the target is Stunned 2</p>",
      "collapsed": false
    }
