  "offensiveAbilities": [
    {
      "name": "Earth Glide",
      "actions": null,
      "traits": [],
      "description": "<p>The living landslide can Burrow through any earthen matter, including rock. When it does so, the living landslide moves at its full burrow Speed, leaving no tunnels or signs of its passing.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>Living landslides resemble humanoids made of earth and gravel.</p>\n<hr />\n<p>Earth elementals make excellent bodyguards for adventuresome spelunkers and are ideal protectors of important subterranean locations such as vaults and treasuries.</p>",
