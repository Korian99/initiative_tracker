  "defensiveAbilities": [
    {
      "name": "Crumble",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> The living landslide takes damage from a hostile source while atop rock or earth.</p>\n<hr />\n<p><strong>Effect</strong> The living landslide crumbles into the ground, Burrowing down 10 feet. This Burrowing does not trigger reactions.</p>\n<p>The living landslide can't Crumble again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    }
  ],
  "speed": "25 ft,\nburrow 25 ft,\n",
