  "offensiveAbilities": [
    {
      "name": "Toss",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Requirements</strong> The beheaded's previous action was a horn Strike that dealt damage to its target</p><hr />\n<p><strong>Effect</strong> The beheaded tosses its head, attempting to move the target creature into another space within reach of its horns. It rolls an Athletics check against the target's Fortitude DC. On a failure, the target remains in place.</p>",
      "collapsed": false
    },
    {
      "name": "Push (10 feet)",
      "actions": 1,
      "traits": [],
      "description": "<p><p><strong>Requirements</strong> The monster's last action was a successful Strike that lists Push in its damage entry</p><hr /><p><strong>Effect</strong> The monster attempts to Shove the creature. This attempt neither applies nor counts toward the monster's multiple attack penalty. If Push lists a distance, change the distance the creature is pushed on a success to that distance.</p></p>",
      "collapsed": true
    }
