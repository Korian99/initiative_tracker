  "offensiveAbilities": [
    {
      "name": "Boneshaking Roar",
      "actions": 2,
      "traits": [
        "incapacitation",
        "sonic"
      ],
      "description": "<p>The saurian warmonger bellows, evoking the power of the primordial world.</p>\n<p>Non-dinosaur creatures within 30 feet take <span class=\"roll\" onclick=\"roll(this)\">10d6</span> sonic damage (DC 34 basic Fortitude save). On a failed save, a creature is also Slowed 2 for 1 round (Stunned <span class=\"roll\" onclick=\"roll(this)\">1d4</span> on a critical failure).</p>\n<p>The saurian can't use Boneshaking Roar again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Primordial Balance",
      "actions": null,
      "traits": [],
      "description": "<p>A warmonger wields their <em>mancatcher</em> in one hand.</p>",
      "collapsed": false
    },
    {
      "name": "Restrain",
      "actions": null,
      "traits": [],
      "description": "<p>When the warmonger makes a successful mancatcher Strike, their target must succeed at a DC 34 Reflex save or become Grabbed until the end of the warmonger's next turn.</p>\n<p>Each time the creature fails an attempt to Escape the warmonger, it takes <span class=\"roll\" onclick=\"roll(this)\">2d6</span> piercing damage.</p>",
      "collapsed": false
    },
    {
      "name": "Three-Limbed Lunge",
      "actions": 1,
      "traits": [],
      "description": "<p>The saurian warmonger makes three Strikes: one Strike each with the weapons in their hands and one Strike with their tail. They can perform these attacks in any order, though each counts toward their multiple attack penalty as normal.</p>\n<p>After making a Three-Limbed Lunge, the warmonger is Off-Guard until the beginning of their next turn.</p>",
      "collapsed": false
    }
  ],
