  "offensiveAbilities": [
    {
      "name": "Battering Charge",
      "actions": 2,
      "traits": [],
      "description": "<p>The Xenowarden biohulk Strides three times, then makes a melee Strike, dealing an additional 4d6 Bludgeoning Damage damage on a hit. If the target of this Strike is an object or construct, this Strike ignores 5 Hardness.</p>",
      "collapsed": false
    },
    {
      "name": "Destructive Power",
      "actions": null,
      "traits": [],
      "description": "<p>Whenever a Xenowarden biohulk makes a melee Strike that would deal bludgeoning damage, that Strike gains the razing trait.</p>",
      "collapsed": false
    },
    {
      "name": "Nature's Fury",
      "actions": 2,
      "traits": [
        "plant",
        "primal"
      ],
      "description": "<p>The Xenowarden biohulk bellows with rage, causing plants to sprout from the ground and hinder the biohulk's enemies. Creatures within 30 feet of the biohulk take 6d8 Slashing Damage damage from the thrashing plants (Basic DC 26 Reflex Saving Throw save), and the area becomes difficult terrain for 10 minutes. The Xenowarden biohulk ignores difficult terrain created by Nature's Fury. Then, the Xenowarden biohulk can attempt an Intimidation check to Demoralize each creature in the area.</p>",
      "collapsed": false
    }
