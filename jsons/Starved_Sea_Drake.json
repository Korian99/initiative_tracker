      "actions": -1,
      "traits": [
        "electricity"
      ],
      "description": "<p><strong>Trigger</strong> An adjacent creature deals piercing or slashing damage to the sea drake</p>\n<hr />\n<p><strong>Effect</strong> An arc of electricity courses through the sea drake's blood. The triggering creature takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> electricity damage.</p>",
