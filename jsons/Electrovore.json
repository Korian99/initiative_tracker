  "offensiveAbilities": [
    {
      "name": "Electrical Discharge",
      "actions": 2,
      "traits": [
        "electricity"
      ],
      "description": "<p><strong>Effect</strong> The electrovore unleashes a shock wave that deals 2d6 Electricity Damage damage to creatures in a 10ft Type:emanation (DC 15 Reflex Saving Throw). It can't use Electrical Discharge again for 1d4 rounds.</p><hr /><p><strong>Critical Success</strong> The target is unaffected.</p>\n<p><strong>Success</strong> The target takes half damage. Items in its possession with the tech trait becomes glitching 1. If the target has the tech trait, it becomes Glitching 1.</p>\n<p><strong>Failure</strong> As success, but full damage and Glitching 2.</p>\n<p><strong>Critical Failure</strong> As success, but double damage and Glitching 3.</p>",
      "collapsed": false
    },
    {
      "name": "Siphon",
      "actions": null,
      "traits": [],
      "description": "<p>When an electrovore scores a critical hit with a tail Strike against a living creature wielding or wearing tech gear or a creature with the tech trait, it siphons off a portion of the target's electrical energy. This restores 5 Healing Damage Hit Points to the electrovore immediately, plus 1 Hit Point per minute for the next 10 minutes; the additional healing doesn't increase if the electrovore siphons multiple times.</p>",
      "collapsed": false
    }
