    {
      "name": "Hold Tight",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature Grabbed by the holdfast's jaws takes damage from another creature's Strike</p>\n<hr />\n<p><strong>Effect</strong> The holdfast Constricts the creature in its jaws.</p>",
