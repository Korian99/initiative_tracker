      "name": "Swarming Bites",
      "actions": 1,
      "traits": [],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">1d8</span> piercing damage (DC 18 basic Reflex save).</p>",
