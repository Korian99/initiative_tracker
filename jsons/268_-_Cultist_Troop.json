  "offensiveAbilities": [
    {
      "name": "Troop Movement",
      "actions": null,
      "traits": [],
      "description": "<p>Whenever a troop Strides, it first Forms Up as a free action to condense into a 20-foot-by–20-foot area (minus any missing squares), then moves up to its Speed. See <em>Bestiary 3</em> for further details.</p>",
      "collapsed": false
    },
    {
      "name": "Wild Swing",
      "actions": 1,
      "traits": [],
      "description": "<p><strong>Frequency</strong> once per round</p>\n<hr />\n<p><strong>Effect</strong> The cultists chaotically swing their weapons—from pixies' tiny rapiers to redcaps' scythes—at each enemy adjacent to the troop (DC 22 basic Reflex save), dealing a small amount of damage to the troop at the same time. The damage depends on the number of actions.</p>\n<p><img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> <span class=\"roll\" onclick=\"roll(this)\">1d12+1</span> slashing damage to enemies and <span class=\"roll\" onclick=\"roll(this)\">1d4</span> slashing damage to the troop</p>\n<p><img src=\"assets/images/actions/2.png\" title=\"2 actions\" alt=\"2 actions\"> <span class=\"roll\" onclick=\"roll(this)\">2d12+1</span> slashing damage and <span class=\"roll\" onclick=\"roll(this)\">1d4+2</span> slashing damage to the troop</p>\n<p><img src=\"assets/images/actions/3.png\" title=\"3 actions\" alt=\"3 actions\"> <span class=\"roll\" onclick=\"roll(this)\">2d12+5</span> slashing damage and <span class=\"roll\" onclick=\"roll(this)\">2d4</span> slashing damage to the troop</p>",
      "collapsed": false
    }
  ],
