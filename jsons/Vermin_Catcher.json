    {
      "name": "Giant Rat Trap",
      "actions": 3,
      "traits": [],
      "description": "<p>The vermin catcher places a rat trap in an adjacent space. Any Small or Medium creature that moves into the space with the trap triggers it and must attempt a DC 18 basic Reflex save. On a failure, the creature takes <span class=\"roll\" onclick=\"roll(this)\">1d4</span> bleed damage (<span class=\"roll\" onclick=\"roll(this)\">2d4</span> bleed on a critical failure) and is Immobilized and Off-Guard for 1 round.</p>",
      "collapsed": false
    },
