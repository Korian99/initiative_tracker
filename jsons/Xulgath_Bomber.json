  "items": [
    {
      "name": "Greatpick",
      "quantity": 1,
      "description": "<p>This pick has a longer handle and broader head than a regular pick. It is too heavy to wield in one hand.</p>",
      "level": 0,
      "price": "2 gp ",
      "traits": [
        "fatal-d12"
      ]
    },
    {
      "name": "Acid Flask (Moderate) (Infused)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Strike</p>\n<p>This flask filled with corrosive acid deals 1 acid damage, <span class=\"roll\" onclick=\"roll(this)\">2d6</span> persistent acid damage, and 2 acid splash damage. You gain a +1 item bonus to attack rolls.</p>",
      "level": 3,
      "price": "10 gp ",
      "traits": [
        "acid",
        "alchemical",
        "bomb",
        "consumable",
        "infused",
        "splash"
      ]
    },
    {
      "name": "Alchemist's Fire (Moderate) (Infused)",
      "quantity": 2,
      "description": "<p><strong>Activate</strong> <img src=\"assets/images/actions/1.png\" title=\"1 action\" alt=\"1 action\"> Strike</p>\n<p>Alchemist's fire is a combination of volatile liquids that ignite when exposed to air. Alchemist's fire deals <span class=\"roll\" onclick=\"roll(this)\">2d8</span> fire damage, 2 persistent fire damage, and 2 fire splash damage. You gain a +1 item bonus to attack rolls.</p>",
      "level": 3,
      "price": "10 gp ",
      "traits": [
        "alchemical",
        "bomb",
        "consumable",
        "fire",
        "infused",
        "splash"
      ]
    },
    {
      "name": "Studded Leather Armor",
      "quantity": 1,
      "description": "<p>This leather armor is reinforced with metal studs and sometimes small metal plates, providing most of the flexibility of leather armor with more robust protection.</p>",
      "level": 0,
      "price": "3 gp ",
      "traits": []
    },
    {
      "name": "Alchemist's Tools",
      "quantity": 1,
      "description": "<p>This mobile collection of vials and chemicals can be used for simple alchemical tasks.</p>",
      "level": 0,
      "price": "3 gp ",
      "traits": []
    },
    {
      "name": "Concentrated Xulgath Bile (Infused)",
      "quantity": 2,
      "description": "<p>The Sickened condition from concentrated xulgath bile doesn't improve on its own until the target recovers from the poison. A target who recovers from concentrated xulgath bile is immune to being sickened by this poison for 1 minute</p>\n<p><strong>Saving Throw</strong> DC 22 Fortitude save</p>\n<hr />\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d10</span> poison damage and Sickened 1 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d10</span> poison damage and Sickened 2 (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">2d10</span> poison damage and Sickened 3 (1 round).</p>",
      "level": 7,
      "price": "",
      "traits": [
        "infused",
        "poison"
      ]
    }
  ],
