  "offensiveAbilities": [
    {
      "name": "Consume Flesh",
      "actions": 1,
      "traits": [
        "manipulate"
      ],
      "description": "<p>The ghoul devours a chunk of a creature that died within the last hour and regains <span class=\"roll\" onclick=\"roll(this)\">1d6</span> healing Hit Points.</p>\n<p>The ghoul can regain Hit Points from a given body only once.</p>",
      "collapsed": false
    },
    {
      "name": "Sneak Attack",
      "actions": null,
      "traits": [],
      "description": "<p>The ghoul stalker deals an extra <span class=\"roll\" onclick=\"roll(this)\">1d4</span> damage to creatures that have the Off-Guard condition.</p></details>",
      "collapsed": false
    },
    {
      "name": "Swift Leap",
      "actions": 1,
      "traits": [
        "move"
      ],
      "description": "<p>The ghoul jumps up to half its Speed. This movement doesn't trigger reactions.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>The flesh-eating undead, known as ghouls, haunt sinister locations such as lonely graveyards and ruined crypts, making meals of corpses. Legends say that those captured by ghouls hear foul whispers that curse them into craving raw meat, eventually turning them into ghouls.</p>",
  "recallKnowledge": "Religion, DC: 15",
