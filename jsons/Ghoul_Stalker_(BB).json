    {
      "name": "Stench",
      "actions": null,
      "traits": [],
      "description": "<p>A creature that comes within 10 feet of the ghoul and can smell the ghoul must attempt a DC 14 Fortitude save. On a failure, the creature takes a -1 status penalty to all checks and DCs until it uses an action to retch (Sickened 1). A creature that succeeds at its save isn't affected by any ghoul's stench for 1 minute.</p>",
      "collapsed": false
    }
