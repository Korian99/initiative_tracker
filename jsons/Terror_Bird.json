    {
      "name": "Tearing Clutch",
      "actions": null,
      "traits": [],
      "description": "<p>The terror bird's powerful beak can tear through flesh. On a successful beak Strike, the target takes 1 bleed damage. This bleed damage increases to <span class=\"roll\" onclick=\"roll(this)\">1d4</span> bleed on a critical hit.</p>",
      "collapsed": false
