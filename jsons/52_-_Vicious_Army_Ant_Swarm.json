  "defensiveAbilities": [
    {
      "name": "Cling",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature leaves the swarm's space</p>\n<hr />\n<p><strong>Effect</strong> The swarm takes <span class=\"roll\" onclick=\"roll(this)\">1d6</span> damage as ants cling to the creature and continue biting, dealing <span class=\"roll\" onclick=\"roll(this)\">7d6</span> persistent plus piercing damage. High winds or immersion in water reduces the DC of the flat check to end this persistent damage to 5. Any area damage dealt to the creature destroys these clinging ants.</p>",
      "collapsed": false
    }
  ],
  "speed": "30 ft,\nclimb 30 ft,\n",
  "strikes": [],
  "offensiveAbilities": [
    {
      "name": "Swarming Bites",
      "actions": 1,
      "traits": [
        "concentrate",
        "manipulate"
      ],
      "description": "<p>Each enemy in the swarm's space takes <span class=\"roll\" onclick=\"roll(this)\">7d6</span> piercing damage (DC 31 basic Fortitude save). A creature that fails its save against Swarming Bites becomes Clumsy 1 for 1 round. If the creature attempts a concentrate or manipulate action while affected, it must succeed at a DC 5 Flat check or the action is lost; roll the check after spending the action, but before any effects are applied.</p>",
      "collapsed": false
    }
  ],
  "spellcastingEntries": [],
  "description": "<p>An army ant swarm is a terrifying carpet of stinging insects that devours all in its path.</p>",
