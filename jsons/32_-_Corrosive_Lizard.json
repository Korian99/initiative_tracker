  ],
  "offensiveAbilities": [
    {
      "name": "Gout of Acid",
      "actions": 2,
      "traits": [
        "acid",
        "primal"
      ],
      "description": "<p>The corrosive lizard vomits a gout of acid in a 15 foot cone. Each creature in this area takes <span class=\"roll\" onclick=\"roll(this)\">3d6</span> acid damage (DC 20 basic Reflex save).</p>\n<p>The lizard can't use Gout of Acid again for <span class=\"roll\" onclick=\"roll(this)\">1d4</span> rounds.</p>",
      "collapsed": false
    },
    {
      "name": "Lurching Charge",
      "actions": 2,
      "traits": [],
      "description": "<p>The corrosive lizard Strides up to double its Speed and then makes a jaws Strike. If the lizard moved at least 20 feet away from its starting position, it gains a +2 circumstance bonus to this attack roll.</p>",
      "collapsed": false
    }
  ],
