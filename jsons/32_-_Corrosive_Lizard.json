    {
      "name": "Gnashing Bite",
      "actions": -1,
      "traits": [],
      "description": "<p><strong>Trigger</strong> A creature Grabbed by the corrosive lizard's jaws fails a check to Escape</p>\n<hr />\n<p><strong>Effect</strong> The lizard's jaws deal <span class=\"roll\" onclick=\"roll(this)\">1d6</span> piercing damage and <span class=\"roll\" onclick=\"roll(this)\">1d6</span> acid damage to the triggering creature.</p>",
      "collapsed": false
    }
