  "items": [
    {
      "name": "Aklys",
      "quantity": 1,
      "description": "<p>The aklys is a throwing club with a hook on one end and a lengthy cord attached to the other. Though aklyses aren't available in most shops, one might be purchased for 5 gp from a vendor that specializes in strange weapons.</p>",
      "level": 0,
      "price": "5 gp ",
      "traits": [
        "uncommon",
        "ranged-trip",
        "tethered",
        "thrown-20",
        "trip"
      ]
    },
    {
      "name": "Hand Crossbow",
      "quantity": 1,
      "description": "<p>Sometimes referred to as an alley bow by rogues or ruffians, this small crossbow fires small bolts that are sometimes used to deliver poison to the target. It's small enough to be shot one-handed, but it still requires two hands to load.</p>",
      "level": 0,
      "price": "3 gp ",
      "traits": []
    },
    {
      "name": "Giant Centipede Venom",
      "quantity": 4,
      "description": "<p>Giant centipede venom causes severe muscle stiffness.</p>\n<p><strong>Activate</strong> <img src=\"assets/images/actions/2.png\" title=\"2 actions\" alt=\"2 actions\"> Interact (Injury)</p>\n<p><strong>Saving Throw</strong> DC 17 Fortitude save</p>\n<p><strong>Maximum Duration</strong> 6 rounds</p>\n<p><strong>Stage 1</strong> <span class=\"roll\" onclick=\"roll(this)\">1d6</span> poison damage (1 round)</p>\n<p><strong>Stage 2</strong> <span class=\"roll\" onclick=\"roll(this)\">1d8</span> poison damage and Off-Guard (1 round)</p>\n<p><strong>Stage 3</strong> <span class=\"roll\" onclick=\"roll(this)\">1d12</span> poison damage, Clumsy 1, and off-guard (1 round)</p>",
      "level": 1,
      "price": "4 gp ",
      "traits": [
        "alchemical",
        "consumable",
        "injury",
        "poison"
      ]
    },
    {
      "name": "Bolts",
      "quantity": 20,
      "description": "<p>Shorter than traditional arrows but similar in construction, bolts are the ammunition used by crossbows.</p>",
      "level": 0,
      "price": "1 sp ",
      "traits": []
    }
